<%- include('../layouts/header') %>

<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 font-serif fw-bold" style="color: var(--primary-dark);">Góc Chia Sẻ & Chăm Sóc Cây</h1>
        <p class="lead text-muted">Những kiến thức hữu ích để cây cảnh của bạn luôn xanh tươi</p>
    </div>

    <div class="row g-4">
        <% if (articles && articles.length > 0) { %>
            <% articles.forEach(article => { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm blog-card rounded-4 overflow-hidden">
                        <a href="/blogs/<%= article.slug %>" class="d-block overflow-hidden" style="height: 240px;">
                            <img src="/images/products/<%= article.image %>" class="card-img-top w-100 h-100" 
                                 style="object-fit: cover; transition: transform 0.5s ease;" 
                                 onerror="this.src='/images/default-article.jpg'" alt="<%= article.title %>">
                        </a>
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-3 text-muted small">
                                <span><i class="far fa-calendar-alt me-2"></i><%= new Date(article.createdAt).toLocaleDateString('vi-VN') %></span>
                                <span class="mx-2">•</span>
                                <span><i class="far fa-eye me-2"></i><%= article.views || 0 %> lượt xem</span>
                            </div>
                            <h5 class="card-title fw-bold mb-3 font-serif">
                                <a href="/blogs/<%= article.slug %>" class="text-dark text-decoration-none article-title-link">
                                    <%= article.title %>
                                </a>
                            </h5>
                            <p class="card-text text-muted mb-4 flex-grow-1">
                                <%= article.summary %>
                            </p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <% if(article.author_id && article.author_id.avatar) { %>
                                        <img src="/images/avatars/<%= article.author_id.avatar %>" class="rounded-circle me-2" width="30" height="30" style="object-fit:cover;">
                                    <% } else { %>
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" style="width:30px; height:30px; font-size:12px;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    <% } %>
                                    <span class="small fw-bold"><%= article.author_id ? article.author_id.fullname : 'Admin' %></span>
                                </div>
                                <a href="/blogs/<%= article.slug %>" class="btn btn-outline-success btn-sm rounded-pill px-3">Đọc tiếp &rarr;</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <i class="far fa-newspaper display-1 text-muted mb-3"></i>
                <h3 class="text-muted">Chưa có bài viết nào</h3>
                <p class="text-muted">Hãy quay lại sau nhé!</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../layouts/footer') %>
