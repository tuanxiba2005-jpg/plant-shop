<%- include('../layouts/header') %>

<% const badges = {
    pending: 'warning', confirmed: 'info',
    shipping: 'primary', delivered: 'success', cancelled: 'danger'
} %>
<% const labels = {
    pending: 'Chờ xác nhận', confirmed: 'Đã xác nhận',
    shipping: 'Đang giao', delivered: 'Đã giao', cancelled: 'Đã hủy'
} %>
<% const paymentLabels = { cod: '💵 Thanh toán khi nhận hàng', bank_transfer: '🏦 Chuyển khoản ngân hàng' } %>

<!-- Thông báo đặt hàng thành công -->
<% if (locals.success) { %>
<div class="alert alert-success d-flex align-items-center gap-2 mb-4">
    <i class="fas fa-check-circle fs-5"></i>
    <div>
        <strong>Đặt hàng thành công!</strong>
        Chúng tôi sẽ xử lý đơn hàng của bạn sớm nhất có thể.
    </div>
</div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h4 class="fw-bold mb-0">
        📦 Đơn hàng #<%= order._id.toString().slice(-8).toUpperCase() %>
    </h4>
    <span class="badge bg-<%= badges[order.status] %> fs-6 px-3 py-2">
        <%= labels[order.status] %>
    </span>
</div>

<!-- Timeline trạng thái -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center order-timeline">
            <% const steps = ['pending','confirmed','shipping','delivered'] %>
            <% const stepLabels = ['Chờ xác nhận','Đã xác nhận','Đang giao','Đã giao'] %>
            <% const stepIcons = ['fa-clock','fa-check','fa-truck','fa-box-open'] %>
            <% const currentIdx = order.status === 'cancelled' ? -1 : steps.indexOf(order.status) %>
            <% steps.forEach((step, i) => { %>
            <div class="timeline-step text-center flex-fill">
                <div class="timeline-icon <%= i <= currentIdx ? 'active' : '' %> <%= order.status === 'cancelled' ? 'cancelled' : '' %>">
                    <i class="fas <%= stepIcons[i] %>"></i>
                </div>
                <div class="timeline-label"><%= stepLabels[i] %></div>
            </div>
            <% if (i < steps.length - 1) { %>
            <div class="timeline-line <%= i < currentIdx ? 'active' : '' %>"></div>
            <% } %>
            <% }) %>
        </div>
        <% if (order.status === 'cancelled') { %>
        <div class="text-center text-danger mt-2" style="font-size:13px;">
            <i class="fas fa-times-circle me-1"></i>Đơn hàng đã bị hủy
        </div>
        <% } %>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Sản phẩm -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white fw-bold">
                <i class="fas fa-shopping-bag me-2"></i>Sản phẩm đã đặt
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>SL</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.items.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="/images/products/<%= item.product_id?.image || 'default.jpg' %>"
                                         width="48" height="48"
                                         style="object-fit:cover; border-radius:6px;"
                                         onerror="this.src='/images/default.jpg'">
                                    <span style="font-size:14px;"><%= item.name %></span>
                                </div>
                            </td>
                            <td><%= parseInt(item.price).toLocaleString('vi-VN') %>đ</td>
                            <td><%= item.quantity %></td>
                            <td class="text-success fw-bold">
                                <%= parseInt(item.price * item.quantity).toLocaleString('vi-VN') %>đ
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="text-success fw-bold fs-5">
                                <%= parseInt(order.total_price).toLocaleString('vi-VN') %>đ
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Thông tin giao hàng -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white fw-bold">
                <i class="fas fa-map-marker-alt me-2"></i>Giao hàng
            </div>
            <div class="card-body" style="font-size:14px;">
                <p class="mb-2"><span class="text-muted">Địa chỉ:</span><br><strong><%= order.address %></strong></p>
                <p class="mb-2"><span class="text-muted">Điện thoại:</span><br><strong><%= order.phone %></strong></p>
                <% if (order.note) { %>
                <p class="mb-0"><span class="text-muted">Ghi chú:</span><br><%= order.note %></p>
                <% } %>
            </div>
        </div>

        <!-- Thông tin đơn hàng -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white fw-bold">
                <i class="fas fa-info-circle me-2"></i>Chi tiết đơn hàng
            </div>
            <div class="card-body" style="font-size:14px;">
                <p class="mb-2">
                    <span class="text-muted">Mã đơn:</span><br>
                    <strong>#<%= order._id.toString().slice(-8).toUpperCase() %></strong>
                </p>
                <p class="mb-2">
                    <span class="text-muted">Ngày đặt:</span><br>
                    <strong><%= new Date(order.createdAt).toLocaleDateString('vi-VN') %></strong>
                </p>
                <p class="mb-2">
                    <span class="text-muted">Thanh toán:</span><br>
                    <strong><%= paymentLabels[order.payment_method] || 'COD' %></strong>
                </p>
                <p class="mb-0">
                    <span class="text-muted">Trạng thái TT:</span><br>
                    <% if (order.payment_status === 'paid') { %>
                        <span class="badge bg-success">Đã thanh toán</span>
                    <% } else { %>
                        <span class="badge bg-warning">Chưa thanh toán</span>
                    <% } %>
                </p>
            </div>
        </div>

        <a href="/orders/my-orders" class="btn btn-outline-success w-100 mb-2">
            <i class="fas fa-arrow-left me-2"></i>Đơn hàng của tôi
        </a>

        <!-- Nút hủy đơn — chỉ hiện khi pending hoặc confirmed -->
        <% if (['pending','confirmed'].includes(order.status)) { %>
        <button class="btn btn-outline-danger w-100" id="btnCancel">
            <i class="fas fa-times me-2"></i>Hủy đơn hàng
        </button>
        <% } %>
    </div>
</div>

<%- include('../layouts/footer') %>