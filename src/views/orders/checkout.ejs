<% extraJS=['/js/address.js'] %>
    <%- include('../layouts/header') %>

        <div class="row">
            <div class="col-md-7">
                <h4 class="fw-bold mb-4">📦 Thông tin đặt hàng</h4>
                <% if (locals.error) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/orders/checkout" method="POST" id="checkoutForm">
                            <!-- Thông tin giao hàng -->
                            <div class="card shadow-sm mb-3">
                                <div
                                    class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-map-marker-alt me-2"></i>Thông tin giao hàng</span>
                                    <button type="button" class="btn btn-light btn-sm" id="btnPickAddress">
                                        <i class="fas fa-map-marker-alt me-1"></i>Chọn địa chỉ đã lưu
                                    </button>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">Họ tên người nhận</label>
                                        <input type="text" class="form-control" value="<%= user.name %>" disabled>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Số điện thoại <span
                                                class="text-danger">*</span></label>
                                        <input type="tel" name="phone" id="checkoutPhone" class="form-control"
                                            placeholder="Nhập số điện thoại" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Địa chỉ giao hàng <span
                                                class="text-danger">*</span></label>
                                        <textarea name="address" id="checkoutAddress" class="form-control" rows="3"
                                            placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"
                                            required></textarea>
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label">Ghi chú</label>
                                        <textarea name="note" class="form-control" rows="2"
                                            placeholder="Ghi chú (không bắt buộc)"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Mã giảm giá -->
                            <div class="card shadow-sm mb-3">
                                <div class="card-header bg-success text-white fw-bold">
                                    <i class="fas fa-tag me-2"></i>Mã giảm giá
                                </div>
                                <div class="card-body">
                                    <div class="input-group">
                                        <input type="text" id="couponInput" class="form-control text-uppercase"
                                            placeholder="Nhập mã giảm giá (không bắt buộc)">
                                        <button type="button" class="btn btn-outline-success" id="btnApplyCoupon">Áp
                                            dụng</button>
                                    </div>
                                    <div id="couponMsg" class="small mt-2"></div>
                                    <input type="hidden" name="coupon_code" id="couponCode">
                                </div>
                            </div>

                            <!-- Phương thức thanh toán -->
                            <div class="card shadow-sm mb-3">
                                <div class="card-header bg-success text-white fw-bold">
                                    <i class="fas fa-credit-card me-2"></i>Phương thức thanh toán
                                </div>
                                <div class="card-body">
                                    <label for="radio-cod" class="payment-option d-block mb-2" id="opt-cod"
                                        style="cursor:pointer;">
                                        <div class="d-flex align-items-center gap-3 p-2 border rounded">
                                            <input id="radio-cod" type="radio" name="payment_method" value="cod"
                                                checked>
                                            <div class="payment-icon">💵</div>
                                            <div>
                                                <div class="fw-bold">Tiền mặt khi nhận hàng (COD)</div>
                                                <small class="text-muted">Thanh toán khi nhận hàng</small>
                                            </div>
                                        </div>
                                    </label>

                                    <label for="radio-bank" class="payment-option d-block mb-2" id="opt-bank"
                                        style="cursor:pointer;">
                                        <div class="d-flex align-items-center gap-3 p-2 border rounded">
                                            <input id="radio-bank" type="radio" name="payment_method"
                                                value="bank_transfer">
                                            <div class="payment-icon">🏦</div>
                                            <div>
                                                <div class="fw-bold">Chuyển khoản ngân hàng</div>
                                                <small class="text-muted">Chuyển khoản trước khi giao hàng</small>
                                            </div>
                                        </div>
                                    </label>

                                    <label for="radio-vnpay" class="payment-option d-block mb-2" id="opt-vnpay"
                                        style="cursor:pointer;">
                                        <div class="d-flex align-items-center gap-3 p-2 border rounded">
                                            <input id="radio-vnpay" type="radio" name="payment_method" value="vnpay">
                                            <div class="payment-icon">💳</div>
                                            <div>
                                                <div class="fw-bold">VNPay</div>
                                                <small class="text-muted">Thẻ ATM / Visa / MasterCard / QR Code</small>
                                            </div>
                                        </div>
                                    </label>

                                    <label for="radio-momo" class="payment-option d-block mb-2" id="opt-momo"
                                        style="cursor:pointer;">
                                        <div class="d-flex align-items-center gap-3 p-2 border rounded">
                                            <input id="radio-momo" type="radio" name="payment_method" value="momo">
                                            <div class="payment-icon">📱</div>
                                            <div>
                                                <div class="fw-bold">Ví MoMo</div>
                                                <small class="text-muted">Thanh toán qua ví MoMo</small>
                                            </div>
                                        </div>
                                    </label>

                                    <div id="bankInfo" class="mt-3 p-3 rounded"
                                        style="background:var(--primary-bg);display:none;">
                                        <div class="fw-bold mb-2 text-success"><i
                                                class="fas fa-university me-2"></i>Thông tin chuyển khoản</div>
                                        <div class="row" style="font-size:14px;">
                                            <div class="col-5 text-muted">Ngân hàng:</div>
                                            <div class="col-7 fw-bold">Vietcombank</div>
                                            <div class="col-5 text-muted mt-1">Số TK:</div>
                                            <div class="col-7 fw-bold mt-1">1234 5678 9012</div>
                                            <div class="col-5 text-muted mt-1">Chủ TK:</div>
                                            <div class="col-7 fw-bold mt-1">PLANT SHOP</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100 py-3 fs-5">
                                <i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng
                            </button>
                        </form>
            </div>

            <!-- Tóm tắt -->
            <div class="col-md-5 mt-4 mt-md-0">
                <h4 class="fw-bold mb-4">🧾 Tóm tắt đơn hàng</h4>
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <% items.forEach(item=> { %>
                            <div class="d-flex align-items-center gap-3 p-3"
                                style="border-bottom:1px solid var(--border-light);">
                                <img src="/images/products/<%= item.image %>" width="54" height="54"
                                    style="object-fit:cover;border-radius:8px;flex-shrink:0;"
                                    onerror="this.src='/images/default.jpg'">
                                <div class="flex-fill">
                                    <div style="font-size:14px;font-weight:500;">
                                        <%= item.name %>
                                    </div>
                                    <small class="text-muted">x<%= item.quantity %></small>
                                </div>
                                <div class="text-success fw-bold" style="font-size:14px;">
                                    <%= parseInt(item.subtotal).toLocaleString('vi-VN') %>đ
                                </div>
                            </div>
                            <% }) %>
                                <div class="p-3">
                                    <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
                                        <span class="text-muted">Tạm tính</span>
                                        <span>
                                            <%= parseInt(total).toLocaleString('vi-VN') %>đ
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2"
                                        style="font-size:14px;display:none!important;" id="discountRow">
                                        <span class="text-muted">Giảm giá</span>
                                        <span class="text-danger fw-bold" id="discountDisplay"></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
                                        <span class="text-muted">Phí vận chuyển</span>
                                        <span class="text-success">Miễn phí</span>
                                    </div>
                                    <hr>
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold">Tổng cộng</span>
                                        <span class="text-success fw-bold fs-5" id="totalDisplay">
                                            <%= parseInt(total).toLocaleString('vi-VN') %>đ
                                        </span>
                                    </div>
                                </div>
                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const radios = document.querySelectorAll('input[name="payment_method"]');
                        const bankInfo = document.getElementById('bankInfo');

                        function updateStyles() {
                            radios.forEach(r => {
                                const box = r.closest('.payment-option').querySelector('div.border');
                                if (r.checked) {
                                    box.style.borderColor = '#198754';
                                    box.style.borderWidth = '2px';
                                    box.style.backgroundColor = '#f8fff9';
                                } else {
                                    box.style.borderColor = '#dee2e6';
                                    box.style.borderWidth = '1px';
                                    box.style.backgroundColor = '#fff';
                                }
                            });
                        }

                        radios.forEach(radio => {
                            radio.addEventListener('change', function () {
                                updateStyles();
                                if (bankInfo) {
                                    bankInfo.style.display = this.value === 'bank_transfer' ? 'block' : 'none';
                                }
                            });
                        });

                        updateStyles();
                    });
                </script><a href="/cart" class="btn btn-outline-success w-100 mt-3"><i
                        class="fas fa-arrow-left me-2"></i>Quay
                    lại giỏ hàng</a>
            </div>
        </div>

        <!-- Modal chọn địa chỉ -->
        <div class="modal fade" id="pickAddressModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">Chọn địa chỉ giao hàng</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="pickAddressList">
                        <div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            const orderTotal = <%= total %>;
            document.addEventListener('DOMContentLoaded', async function () {
                try {
                    const res = await fetch('/user/addresses');
                    const data = await res.json();
                    if (data.success && data.addresses.length > 0) {
                        const def = data.addresses.find(a => a.isDefault) || data.addresses[0];
                        document.getElementById('checkoutPhone').value = def.phone;
                        document.getElementById('checkoutAddress').value = def.address;
                    }
                } catch (e) { }

                document.getElementById('btnPickAddress').addEventListener('click', async function () {
                    const modal = new bootstrap.Modal(document.getElementById('pickAddressModal'));
                    const list = document.getElementById('pickAddressList');
                    list.innerHTML = '<div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i></div>';
                    modal.show();
                    try {
                        const res = await fetch('/user/addresses');
                        const data = await res.json();
                        if (!data.success || !data.addresses.length) {
                            list.innerHTML = '<div class="text-center text-muted py-4">Chưa có địa chỉ nào. <a href="/user/profile?tab=address" class="text-success">Thêm địa chỉ</a></div>';
                            return;
                        }
                        list.innerHTML = data.addresses.map(a => `
                <div class="border rounded p-3 mb-2 ${a.isDefault ? 'border-success' : ''}" style="cursor:pointer"
                     onclick="applyAddress('${a.phone.replace(/'/g, "\\'")}','${a.address.replace(/'/g, "\\'").replace(/\n/g, ' ')}')">
                    <strong>${a.name}</strong> ${a.isDefault ? '<span class="badge bg-success">Mặc định</span>' : ''}
                    <div class="text-muted small">${a.phone}</div>
                    <div class="small">${a.address}</div>
                </div>`).join('');
                    } catch (e) { }
                });

                document.getElementById('btnApplyCoupon').addEventListener('click', async function () {
                    const code = document.getElementById('couponInput').value.trim();
                    const msg = document.getElementById('couponMsg');
                    if (!code) { msg.innerHTML = '<span class="text-danger">Vui lòng nhập mã</span>'; return; }
                    const res = await fetch('/orders/apply-coupon', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `code=${encodeURIComponent(code)}&total=${orderTotal}`
                    });
                    const data = await res.json();
                    if (data.valid) {
                        document.getElementById('couponCode').value = code;
                        document.getElementById('discountRow').style.cssText = '';
                        document.getElementById('discountDisplay').textContent = '-' + parseInt(data.discount).toLocaleString('vi-VN') + 'đ';
                        document.getElementById('totalDisplay').textContent = parseInt(orderTotal - data.discount).toLocaleString('vi-VN') + 'đ';
                        msg.innerHTML = '<span class="text-success"><i class="fas fa-check me-1"></i>Áp dụng thành công!</span>';
                    } else {
                        document.getElementById('couponCode').value = '';
                        document.getElementById('discountRow').style.cssText = 'display:none!important;';
                        document.getElementById('totalDisplay').textContent = parseInt(orderTotal).toLocaleString('vi-VN') + 'đ';
                        msg.innerHTML = `<span class="text-danger">${data.message}</span>`;
                    }
                });
            });
            function applyAddress(phone, address) {
                document.getElementById('checkoutPhone').value = phone;
                document.getElementById('checkoutAddress').value = address;
                bootstrap.Modal.getInstance(document.getElementById('pickAddressModal')).hide();
            }
        </script>
        <%- include('../layouts/footer') %>