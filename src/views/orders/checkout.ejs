<% extraJS=['/js/checkout.js', '/js/address.js'] %>
<% locals.hideFooter = true; %>
<%- include('../layouts/header') %>

<style>
/* Luxury Checkout Styles */
.checkout-wrapper {
    font-family: 'Inter', sans-serif;
    color: var(--text-primary);
    background-color: var(--bg-light);
    padding: 40px 0 80px;
}
.checkout-title {
    font-family: 'Playfair Display', serif;
    color: var(--primary-dark);
    font-size: 28px;
    font-weight: 700;
}
.checkout-card {
    background: #fff;
    border: none;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    margin-bottom: 24px;
    overflow: hidden;
}
.checkout-card-header {
    background: transparent;
    border-bottom: 1px solid var(--border-light);
    padding: 20px 24px;
    font-weight: 600;
    font-size: 18px;
    display: flex;
    align-items: center;
}
.checkout-card-header i {
    color: var(--primary);
    margin-right: 12px;
    font-size: 20px;
}
.checkout-card-body {
    padding: 24px;
}
.form-label {
    font-size: 14px;
    font-weight: 500;
    color: #495057;
    margin-bottom: 8px;
}
.form-control, .form-select {
    border-radius: 8px;
    border: 1px solid #ced4da;
    padding: 12px 16px;
    font-size: 15px;
    transition: all 0.2s ease;
}
.form-control:focus, .form-select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(45, 95, 63, 0.1);
}
.payment-option {
    display: block;
    cursor: pointer;
    margin-bottom: 16px;
}
.payment-card {
    border: 1px solid #ced4da;
    border-radius: 10px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.2s ease;
}
.payment-option input[type="radio"] {
    width: 20px;
    height: 20px;
    accent-color: var(--primary);
}
.payment-option input[type="radio"]:checked + .payment-card {
    border-color: var(--primary);
    background-color: rgba(45, 95, 63, 0.03);
}
.payment-icon {
    font-size: 28px;
    width: 48px;
    text-align: center;
}
.payment-title {
    font-weight: 600;
    font-size: 16px;
    color: #212529;
}
.payment-desc {
    font-size: 13px;
    color: #6c757d;
    margin-top: 2px;
}
.order-summary-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--border-light);
}
.order-summary-img {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
    background: #f8f9fa;
}
.btn-checkout {
    background-color: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 16px;
    font-size: 18px;
    font-weight: 600;
    transition: all 0.3s ease;
}
.btn-checkout:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(45, 95, 63, 0.2);
}
.trust-badges {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
    color: #6c757d;
    font-size: 12px;
}
.trust-badges div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}
.trust-badges i {
    font-size: 20px;
}
</style>

<div class="checkout-wrapper">
    <div class="container">
        <h1 class="checkout-title mb-4">Thông tin đặt hàng</h1>

        <% if (locals.error) { %>
            <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                <i class="fas fa-exclamation-circle me-2"></i><%= error %>
            </div>
        <% } %>

        <form action="/orders/checkout" method="POST" id="checkoutForm">
            <div class="row g-4">
                <!-- Cột trái: Thông tin Form -->
                <div class="col-lg-7">
                    
                    <!-- Thông tin người nhận -->
                    <div class="checkout-card">
                        <div class="checkout-card-header">
                            <i class="fas fa-user-circle"></i> Thông tin người nhận
                        </div>
                        <div class="checkout-card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Họ và tên</label>
                                    <input type="text" class="form-control" value="<%= user.name %>" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                    <input type="tel" name="phone" id="checkoutPhone" class="form-control" placeholder="Ví dụ: 0912345678" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" value="<%= user.email %>" disabled>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Địa chỉ giao hàng -->
                    <div class="checkout-card">
                        <div class="checkout-card-header justify-content-between">
                            <div><i class="fas fa-map-marked-alt"></i> Địa chỉ giao hàng</div>
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" id="btnPickAddress">
                                <i class="fas fa-bookmark me-1"></i> Sổ địa chỉ
                            </button>
                        </div>
                        <div class="checkout-card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                    <select class="form-select" id="provinceSelect" required>
                                        <option value="">Chọn Tỉnh/Thành</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Quận / Huyện <span class="text-danger">*</span></label>
                                    <select class="form-select" id="districtSelect" required disabled>
                                        <option value="">Chọn Quận/Huyện</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phường / Xã <span class="text-danger">*</span></label>
                                    <select class="form-select" id="wardSelect" required disabled>
                                        <option value="">Chọn Phường/Xã</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Địa chỉ cụ thể (Số nhà, tên đường) <span class="text-danger">*</span></label>
                                    <input type="text" id="streetInput" class="form-control" placeholder="Ví dụ: 123 Đường ABC..." required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ghi chú cho đơn vị vận chuyển</label>
                                    <textarea name="note" class="form-control" rows="2" placeholder="Giao hàng vào giờ hành chính, gọi trước khi giao..."></textarea>
                                </div>
                            </div>
                            <!-- Hidden input lưu chuỗi địa chỉ gộp lại cho backend -->
                            <input type="hidden" name="address" id="checkoutAddressFinal">
                            <!-- Hidden input lưu danh sách sản phẩm được chọn để mua -->
                            <input type="hidden" name="selected_items" value="<%= locals.selectedIds || '' %>">
                        </div>
                    </div>

                    <!-- Phương thức thanh toán -->
                    <div class="checkout-card">
                        <div class="checkout-card-header">
                            <i class="fas fa-wallet"></i> Phương thức thanh toán
                        </div>
                        <div class="checkout-card-body">
                            <label class="payment-option">
                                <input type="radio" name="payment_method" value="cod" class="d-none" checked>
                                <div class="payment-card">
                                    <div class="payment-icon">💵</div>
                                    <div>
                                        <div class="payment-title">Thanh toán khi nhận hàng (COD)</div>
                                        <div class="payment-desc">Thanh toán bằng tiền mặt khi shipper giao hàng tới</div>
                                    </div>
                                    <i class="fas fa-check-circle text-success ms-auto fs-4 check-icon d-none"></i>
                                </div>
                            </label>

                            <label class="payment-option">
                                <input type="radio" name="payment_method" value="bank_transfer" class="d-none">
                                <div class="payment-card flex-wrap">
                                    <div class="d-flex align-items-center gap-3 w-100">
                                        <div class="payment-icon">🏦</div>
                                        <div>
                                            <div class="payment-title">Chuyển khoản ngân hàng</div>
                                            <div class="payment-desc">Chuyển khoản trực tiếp 24/7 an toàn</div>
                                        </div>
                                        <i class="fas fa-check-circle text-success ms-auto fs-4 check-icon d-none"></i>
                                    </div>
                                    <!-- Dropdown Bank Info -->
                                    <div class="w-100 mt-2 p-3 bg-light rounded d-none" id="bankInfoPanel">
                                        <div class="row text-sm">
                                            <div class="col-5 text-muted mb-1">Ngân hàng:</div>
                                            <div class="col-7 fw-bold mb-1">Vietcombank</div>
                                            <div class="col-5 text-muted mb-1">Số tài khoản:</div>
                                            <div class="col-7 fw-bold mb-1">1234 5678 9012</div>
                                            <div class="col-5 text-muted">Chủ tài khoản:</div>
                                            <div class="col-7 fw-bold text-uppercase">Tuan's Green Plant Shop</div>
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <label class="payment-option">
                                <input type="radio" name="payment_method" value="vnpay" class="d-none">
                                <div class="payment-card">
                                    <div class="payment-icon"><img src="/images/vnpay-logo.png" alt="VNPAY" style="height: 24px; object-fit: contain;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"><span style="display:none;">💳</span></div>
                                    <div>
                                        <div class="payment-title">Cổng thanh toán VNPAY</div>
                                        <div class="payment-desc">Hỗ trợ thẻ ATM, Visa, MasterCard, VNPAY QR</div>
                                    </div>
                                    <i class="fas fa-check-circle text-success ms-auto fs-4 check-icon d-none"></i>
                                </div>
                            </label>

                            <label class="payment-option">
                                <input type="radio" name="payment_method" value="momo" class="d-none">
                                <div class="payment-card">
                                    <div class="payment-icon"><img src="/images/momo-logo.png" alt="MoMo" style="height: 28px; object-fit: contain;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"><span style="display:none;">📱</span></div>
                                    <div>
                                        <div class="payment-title">Ví MoMo</div>
                                        <div class="payment-desc">Quét mã QR qua ứng dụng MoMo</div>
                                    </div>
                                    <i class="fas fa-check-circle text-success ms-auto fs-4 check-icon d-none"></i>
                                </div>
                            </label>
                        </div>
                    </div>

                </div>

                <!-- Cột phải: Tóm tắt đơn hàng -->
                <div class="col-lg-5">
                    <div class="sticky-top" style="top: 100px;">
                        <div class="checkout-card">
                            <div class="checkout-card-header">
                                <i class="fas fa-shopping-bag"></i> Tóm tắt đơn hàng
                            </div>
                            <div class="checkout-card-body p-0">
                                <div class="px-4 py-2" style="max-height: 350px; overflow-y: auto;">
                                    <% items.forEach(item => { %>
                                        <div class="order-summary-item">
                                            <img src="/images/products/<%= item.image %>" class="order-summary-img" onerror="this.src='/images/default.jpg'">
                                            <div class="flex-grow-1">
                                                <div class="fw-bold" style="font-size: 15px; color: var(--text-primary);"><%= item.name %></div>
                                                <div class="text-muted small mt-1">Số lượng: <%= item.quantity %></div>
                                            </div>
                                            <div class="fw-bold" style="color: var(--primary);">
                                                <%= parseInt(item.subtotal).toLocaleString('vi-VN') %>đ
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                                
                                <div class="p-4 bg-light border-top border-bottom">
                                    <div class="input-group">
                                        <input type="text" id="couponInput" class="form-control text-uppercase bg-white" placeholder="Mã ưu đãi...">
                                        <button type="button" class="btn btn-outline-success px-4 fw-bold" id="btnApplyCoupon">Áp dụng</button>
                                    </div>
                                    <div id="couponMsg" class="small mt-2"></div>
                                    <input type="hidden" name="coupon_code" id="couponCode">
                                </div>

                                <div class="p-4">
                                    <div class="d-flex justify-content-between mb-3 text-muted">
                                        <span>Tạm tính</span>
                                        <span class="fw-medium text-dark"><%= parseInt(total).toLocaleString('vi-VN') %>đ</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3 text-muted" id="discountRow" style="display:none!important;">
                                        <span>Khuyến mãi</span>
                                        <span class="text-danger fw-bold" id="discountDisplay"></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3 text-muted">
                                        <span>Phí vận chuyển</span>
                                        <span class="text-success fw-medium">Miễn phí</span>
                                    </div>
                                    <hr class="my-3">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <span class="fw-bold fs-5 text-dark">Tổng cộng</span>
                                        <span class="fw-bold fs-4" style="color: var(--primary);" id="totalDisplay">
                                            <%= parseInt(total).toLocaleString('vi-VN') %>đ
                                        </span>
                                    </div>

                                    <button type="submit" class="btn-checkout w-100" id="btnSubmitOrder">
                                        HOÀN TẤT ĐẶT HÀNG <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Trust badges -->
                        <div class="trust-badges">
                            <div>
                                <i class="fas fa-shield-alt"></i>
                                <span>Bảo mật 100%</span>
                            </div>
                            <div>
                                <i class="fas fa-box-open"></i>
                                <span>Kiểm tra khi nhận</span>
                            </div>
                            <div>
                                <i class="fas fa-sync"></i>
                                <span>Đổi trả 7 ngày</span>
                            </div>
                        </div>

                        <input type="hidden" id="checkoutTotalData" value="<%= total %>">
                        <div class="text-center mt-4">
                            <a href="/cart" class="text-muted text-decoration-none hover-primary">
                                <i class="fas fa-chevron-left me-1"></i> Quay lại giỏ hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal chọn địa chỉ (Giữ nguyên) -->
<div class="modal fade" id="pickAddressModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title font-serif"><i class="fas fa-map-marked-alt me-2"></i>Sổ địa chỉ của bạn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light" id="pickAddressList">
                <div class="text-center py-4"><i class="fas fa-spinner fa-spin fs-4 text-success"></i></div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>