<% extraJS = ['/js/address.js'] %>
<%- include('../layouts/header') %>

<div class="row">
    <div class="col-md-7">
        <h4 class="fw-bold mb-4">📦 Thông tin đặt hàng</h4>

        <% if (locals.error) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i><%= error %></div>
        <% } %>

        <form action="/orders/checkout" method="POST" id="checkoutForm">
            <!-- Thông tin giao hàng -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-map-marker-alt me-2"></i>Thông tin giao hàng</span>
                    <button type="button" class="btn btn-light btn-sm" id="btnPickAddress">
                        <i class="fas fa-map-marker-alt me-1"></i>Chọn địa chỉ đã lưu
                    </button>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Họ tên người nhận <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" value="<%= user.name %>" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="tel" name="phone" id="checkoutPhone" class="form-control"
                               placeholder="Nhập số điện thoại" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                        <textarea name="address" id="checkoutAddress" class="form-control" rows="3"
                                  placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"
                                  required></textarea>
                    </div>
                    <div class="mb-1">
                        <label class="form-label">Ghi chú</label>
                        <textarea name="note" class="form-control" rows="2"
                                  placeholder="Ghi chú cho người giao hàng (không bắt buộc)"></textarea>
                    </div>
                </div>
            </div>

            <!-- Phương thức thanh toán -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white fw-bold">
                    <i class="fas fa-credit-card me-2"></i>Phương thức thanh toán
                </div>
                <div class="card-body">
                    <div class="payment-option selected" id="opt-cod" onclick="selectPayment('cod')">
                        <input type="radio" name="payment_method" value="cod"
                               id="cod" checked style="display:none;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="payment-icon">💵</div>
                            <div>
                                <div class="fw-bold">Thanh toán khi nhận hàng (COD)</div>
                                <small class="text-muted">Thanh toán bằng tiền mặt khi nhận hàng</small>
                            </div>
                            <i class="fas fa-check-circle ms-auto text-success check-icon"></i>
                        </div>
                    </div>

                    <div class="payment-option mt-2" id="opt-bank" onclick="selectPayment('bank_transfer')">
                        <input type="radio" name="payment_method" value="bank_transfer"
                               id="bank_transfer" style="display:none;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="payment-icon">🏦</div>
                            <div>
                                <div class="fw-bold">Chuyển khoản ngân hàng</div>
                                <small class="text-muted">Chuyển khoản trước khi giao hàng</small>
                            </div>
                            <i class="fas fa-check-circle ms-auto text-success check-icon" style="opacity:0;"></i>
                        </div>
                    </div>

                    <!-- Thông tin chuyển khoản -->
                    <div id="bankInfo" class="mt-3 p-3 rounded" style="background:var(--primary-bg); display:none;">
                        <div class="fw-bold mb-2 text-success">
                            <i class="fas fa-university me-2"></i>Thông tin chuyển khoản
                        </div>
                        <div class="row" style="font-size:14px;">
                            <div class="col-5 text-muted">Ngân hàng:</div>
                            <div class="col-7 fw-bold">Vietcombank</div>
                            <div class="col-5 text-muted mt-1">Số tài khoản:</div>
                            <div class="col-7 fw-bold mt-1">1234 5678 9012</div>
                            <div class="col-5 text-muted mt-1">Chủ tài khoản:</div>
                            <div class="col-7 fw-bold mt-1">PLANT SHOP</div>
                            <div class="col-5 text-muted mt-1">Nội dung CK:</div>
                            <div class="col-7 fw-bold mt-1 text-success">PLANTSHOP [tên của bạn]</div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 py-3 fs-5" id="btnOrder">
                <i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng
            </button>
        </form>
    </div>

    <!-- Tóm tắt đơn hàng -->
    <div class="col-md-5 mt-4 mt-md-0">
        <h4 class="fw-bold mb-4">🧾 Tóm tắt đơn hàng</h4>
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <% items.forEach(item => { %>
                <div class="d-flex align-items-center gap-3 p-3" style="border-bottom: 1px solid var(--border-light);">
                    <img src="/images/products/<%= item.image %>"
                         width="54" height="54"
                         style="object-fit:cover; border-radius:8px; flex-shrink:0;"
                         onerror="this.src='/images/default.jpg'">
                    <div class="flex-fill">
                        <div style="font-size:14px; font-weight:500;"><%= item.name %></div>
                        <small class="text-muted">x<%= item.quantity %></small>
                    </div>
                    <div class="text-success fw-bold" style="font-size:14px; flex-shrink:0;">
                        <%= parseInt(item.subtotal).toLocaleString('vi-VN') %>đ
                    </div>
                </div>
                <% }) %>

                <div class="p-3">
                    <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
                        <span class="text-muted">Tạm tính</span>
                        <span><%= parseInt(total).toLocaleString('vi-VN') %>đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
                        <span class="text-muted">Phí vận chuyển</span>
                        <span class="text-success">Miễn phí</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Tổng cộng</span>
                        <span class="text-success fw-bold fs-5">
                            <%= parseInt(total).toLocaleString('vi-VN') %>đ
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <a href="/cart" class="btn btn-outline-success w-100 mt-3">
            <i class="fas fa-arrow-left me-2"></i>Quay lại giỏ hàng
        </a>
    </div>
</div>

<!-- Modal: Chọn địa chỉ đã lưu -->
<div class="modal fade" id="pickAddressModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-map-marker-alt me-2"></i>Chọn địa chỉ giao hàng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="pickAddressList">
                <div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async function () {
    // Tự động điền địa chỉ mặc định khi load trang
    try {
        const res  = await fetch('/user/addresses');
        const data = await res.json();
        if (data.success && data.addresses.length > 0) {
            const def = data.addresses.find(a => a.isDefault) || data.addresses[0];
            document.getElementById('checkoutPhone').value   = def.phone;
            document.getElementById('checkoutAddress').value = def.address;
        }
    } catch (e) {}

    // Nút "Chọn địa chỉ đã lưu"
    document.getElementById('btnPickAddress').addEventListener('click', async function () {
        const modal = new bootstrap.Modal(document.getElementById('pickAddressModal'));
        const list  = document.getElementById('pickAddressList');
        list.innerHTML = '<div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>';
        modal.show();

        try {
            const res  = await fetch('/user/addresses');
            const data = await res.json();

            if (!data.success || data.addresses.length === 0) {
                list.innerHTML = `
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-map-marker-alt fa-2x mb-2 d-block"></i>
                        Bạn chưa có địa chỉ nào.
                        <a href="/user/profile?tab=address" class="d-block mt-2 text-success">Thêm địa chỉ ngay</a>
                    </div>`;
                return;
            }

            list.innerHTML = data.addresses.map(addr => `
                <div class="border rounded p-3 mb-2 ${addr.isDefault ? 'border-success' : ''}"
                     style="cursor:pointer;"
                     onclick="applyAddress('${addr.phone.replace(/'/g,"\\'")}', '${addr.address.replace(/'/g,"\\'").replace(/\n/g,' ')}')">
                    <div class="d-flex justify-content-between">
                        <strong>${addr.name}</strong>
                        ${addr.isDefault ? '<span class="badge bg-success">Mặc định</span>' : ''}
                    </div>
                    <div class="text-muted small">${addr.phone}</div>
                    <div class="small">${addr.address}</div>
                </div>
            `).join('');
        } catch (e) {
            list.innerHTML = '<div class="text-danger text-center py-3">Lỗi tải địa chỉ.</div>';
        }
    });
});

function applyAddress(phone, address) {
    document.getElementById('checkoutPhone').value   = phone;
    document.getElementById('checkoutAddress').value = address;
    bootstrap.Modal.getInstance(document.getElementById('pickAddressModal')).hide();
}
</script>

<%- include('../layouts/footer') %>
