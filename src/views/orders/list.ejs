<%- include('../layouts/header') %>

<style>
    body { background-color: #f5f5f5; }
    .order-tabs {
        display: flex;
        overflow-x: auto;
        white-space: nowrap;
        background: #fff;
        position: sticky;
        top: 0;
        z-index: 1000;
    }
    .order-tabs::-webkit-scrollbar { display: none; }
    .order-tabs { -ms-overflow-style: none; scrollbar-width: none; }
    
    .order-tabs .tab-item {
        flex: 1;
        text-align: center;
        padding: 15px 20px;
        color: #555;
        text-decoration: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        font-weight: 500;
    }
    .order-tabs .tab-item:hover {
        color: var(--primary);
    }
    .order-tabs .tab-item.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
    }
    .order-card {
        background: #fff;
        margin-bottom: 15px;
        border-radius: 2px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .order-card-header {
        padding: 15px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .order-card-body {
        padding: 15px;
        cursor: pointer;
    }
    .order-card-body:hover {
        background-color: #fafafa;
    }
    .product-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px dashed #f0f0f0;
    }
    .product-item:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }
    .product-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border: 1px solid #e1e1e1;
        background-color: #fff;
    }
    .product-info {
        flex: 1;
        margin-left: 15px;
    }
    .order-card-footer {
        padding: 15px;
        border-top: 1px solid #f0f0f0;
        text-align: right;
        background-color: #fffefb;
    }
    .order-total-price {
        font-size: 22px;
        color: #ee4d2d;
    }
</style>

<div class="container py-4" style="max-width: 900px;">
    <!-- Nút Back & Tiêu đề -->
    <div class="d-flex align-items-center mb-3">
        <a href="/user/profile" class="text-decoration-none text-dark me-3" style="font-size: 20px;"><i class="fas fa-arrow-left"></i></a>
        <h4 class="fw-bold mb-0 text-success">Đơn mua của tôi</h4>
    </div>

    <!-- Tabs Navigation -->
    <div class="order-tabs mb-3 shadow-sm rounded-top" id="orderTabs">
        <div class="tab-item active" data-status="all">Tất cả</div>
        <div class="tab-item" data-status="pending">Chờ xác nhận</div>
        <div class="tab-item" data-status="confirmed">Chờ lấy hàng</div>
        <div class="tab-item" data-status="shipping">Đang giao</div>
        <div class="tab-item" data-status="delivered">Hoàn thành</div>
        <div class="tab-item" data-status="cancelled">Đã hủy</div>
    </div>

    <!-- Danh sách Đơn hàng -->
    <% if (orders.length === 0) { %>
        <div class="text-center py-5 bg-white shadow-sm rounded">
            <div class="fs-1 mb-3">📭</div>
            <h5 class="text-muted">Bạn chưa có đơn hàng nào</h5>
            <a href="/products" class="btn btn-success mt-3 px-4">Mua sắm ngay</a>
        </div>
    <% } else { %>
        <div id="ordersContainer">
            <% const labels = { pending: 'CHỜ XÁC NHẬN', confirmed: 'CHỜ LẤY HÀNG', shipping: 'ĐANG GIAO', delivered: 'GIAO HÀNG THÀNH CÔNG', cancelled: 'ĐÃ HỦY' }; %>
            <% const colors = { pending: '#ff9800', confirmed: '#0dcaf0', shipping: '#2196f3', delivered: '#4caf50', cancelled: '#f44336' }; %>

            <% orders.forEach(order => { %>
                <div class="order-card" data-status="<%= order.status %>">
                    <!-- Shop Header -->
                    <div class="order-card-header">
                        <div class="fw-bold">
                            <span class="badge bg-success me-2">Mall</span>
                            <i class="fas fa-leaf text-success me-1"></i> <span class="fs-6">🌿 Plant Shop</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <% if(order.status === 'delivered') { %>
                                <span class="text-success me-2 border-end pe-2"><i class="fas fa-truck"></i> Giao hàng thành công</span>
                            <% } %>
                            <span style="color: <%= colors[order.status] %>; font-weight: 600;">
                                <%= labels[order.status] %>
                            </span>
                        </div>
                    </div>
                    
                    <!-- Products -->
                    <div class="order-card-body" onclick="window.location.href='/orders/<%= order._id %>'">
                        <% order.items.forEach(item => { %>
                            <div class="product-item">
                                <img src="<%= item.product_id?.image || '/images/default.png' %>" alt="<%= item.name %>" class="product-img">
                                <div class="product-info d-flex justify-content-between">
                                    <div>
                                        <div class="fw-medium text-dark fs-6"><%= item.name %></div>
                                        <div class="text-muted small mt-1">Phân loại hàng: Mặc định</div>
                                        <div class="text-muted small mt-1">x<%= item.quantity %></div>
                                    </div>
                                    <div class="text-dark fw-bold fs-6">₫<%= parseInt(item.price).toLocaleString('vi-VN') %></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    
                    <!-- Footer: Total & Actions -->
                    <div class="order-card-footer">
                        <div class="mb-3">
                            <span class="text-dark fw-medium fs-6"><i class="fas fa-shield-alt text-success me-1"></i> Thành tiền: </span>
                            <span class="order-total-price fw-bold">₫<%= parseInt(order.total_price).toLocaleString('vi-VN') %></span>
                        </div>
                        
                        <div class="d-flex justify-content-end gap-2 align-items-center">
                            <div class="text-muted small me-auto d-none d-md-block">Mã đơn: #<%= order._id.toString().slice(-8).toUpperCase() %></div>
                            
                            <% let canRetryPayment=false; if (order.status==='pending' && order.payment_status==='unpaid' && ['vnpay', 'momo'].includes(order.payment_method)) { const fifteenMinsAgo=new Date(Date.now() - 15 * 60 * 1000); if (new Date(order.createdAt)> fifteenMinsAgo) { canRetryPayment = true; } } %>
                            
                            <% if (canRetryPayment) { %>
                                <form action="/orders/<%= order._id %>/retry-payment" method="POST" class="m-0">
                                    <button type="submit" class="btn btn-success px-4 fw-bold">Thanh toán</button>
                                </form>
                            <% } %>

                            <!-- Buttons based on status -->
                            <% if (order.status === 'delivered') { %>
                                <!-- Check if needs review -->
                                <% 
                                    let allReviewed = true;
                                    order.items.forEach(item => {
                                        if (item.product_id) {
                                            const pid = item.product_id._id ? item.product_id._id.toString() : item.product_id.toString();
                                            if (!reviewStatus || !reviewStatus[`${order._id}_${pid}`]) {
                                                allReviewed = false;
                                            }
                                        }
                                    });
                                %>
                                <% if (!allReviewed) { %>
                                    <a href="/orders/<%= order._id %>" class="btn btn-outline-success px-4">Đánh giá</a>
                                <% } %>
                                <a href="/products" class="btn btn-success px-4">Mua lại</a>
                            <% } else if (order.status === 'cancelled') { %>
                                <a href="/products" class="btn btn-success px-4">Mua lại</a>
                            <% } else if (['pending', 'confirmed'].includes(order.status)) { %>
                                <a href="/orders/<%= order._id %>" class="btn btn-outline-secondary px-4">Đang xử lý</a>
                            <% } else if (order.status === 'shipping') { %>
                                <a href="/orders/<%= order._id %>" class="btn btn-success px-4">Đã nhận được hàng</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const initialTab = urlParams.get('tab') || 'all';
    
    const tabs = document.querySelectorAll('.tab-item');
    const cards = document.querySelectorAll('.order-card');

    function switchTab(status) {
        tabs.forEach(t => t.classList.remove('active'));
        const activeTab = document.querySelector(`.tab-item[data-status="${status}"]`);
        if(activeTab) {
            activeTab.classList.add('active');
            // Cuộn tab đang active vào vùng nhìn thấy (nếu trên mobile)
            activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        cards.forEach(card => {
            if (status === 'all' || card.dataset.status === status) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const status = tab.dataset.status;
            // Thay đổi URL mà không tải lại trang
            window.history.pushState({}, '', `/orders/my-orders?tab=${status}`);
            switchTab(status);
        });
    });

    // Run initial filter
    switchTab(initialTab);
});
</script>

<%- include('../layouts/footer') %>