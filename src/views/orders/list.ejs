<% locals.hideFooter = true; %>
<%- include('../layouts/header') %>

    <style>
        body {
            background-color: #f5f5f5;
        }

        .order-tabs {
            display: flex;
            overflow-x: auto;
            white-space: nowrap;
            background: #fff;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .order-tabs::-webkit-scrollbar {
            display: none;
        }

        .order-tabs {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .order-tabs .tab-item {
            flex: 1;
            text-align: center;
            padding: 15px 20px;
            color: #555;
            text-decoration: none;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            font-weight: 500;
        }

        .order-tabs .tab-item:hover {
            color: var(--primary);
        }

        .order-tabs .tab-item.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
        }

        .order-card {
            background: #fff;
            margin-bottom: 15px;
            border-radius: 2px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .order-card-header {
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .order-card-body {
            padding: 15px;
            cursor: pointer;
        }

        .order-card-body:hover {
            background-color: #fafafa;
        }

        .product-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px dashed #f0f0f0;
        }

        .product-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .product-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border: 1px solid #e1e1e1;
            background-color: #fff;
        }

        .product-info {
            flex: 1;
            margin-left: 15px;
        }

        .order-card-footer {
            padding: 15px;
            border-top: 1px solid #f0f0f0;
            text-align: right;
            background-color: #fffefb;
        }

        .order-total-price {
            font-size: 22px;
            color: #ee4d2d;
        }
    </style>

    <div class="container py-4" style="max-width: 900px;">
        <!-- Nút Back & Tiêu đề -->
        <div class="d-flex align-items-center mb-3">
            <a href="/user/profile" class="text-decoration-none text-dark me-3" style="font-size: 20px;"><i
                    class="fas fa-arrow-left"></i></a>
            <h4 class="fw-bold mb-0 text-success">Đơn mua của tôi</h4>
        </div>

        <!-- Tabs Navigation -->
        <div class="order-tabs mb-3 shadow-sm rounded-top" id="orderTabs">
            <div class="tab-item active" data-status="all">Tất cả</div>
            <div class="tab-item" data-status="pending">Chờ xác nhận</div>
            <div class="tab-item" data-status="confirmed">Chờ lấy hàng</div>
            <div class="tab-item" data-status="shipping">Đang giao</div>
            <div class="tab-item" data-status="delivered">Hoàn thành</div>
            <div class="tab-item" data-status="cancelled">Đã hủy</div>
        </div>

        <!-- Danh sách Đơn hàng -->
        <% if (orders.length===0) { %>
            <div class="text-center py-5 bg-white shadow-sm rounded">
                <div class="fs-1 mb-3">📭</div>
                <h5 class="text-muted">Bạn chưa có đơn hàng nào</h5>
                <a href="/products" class="btn btn-success mt-3 px-4">Mua sắm ngay</a>
            </div>
            <% } else { %>
                <div id="ordersContainer">
                    <% const labels={ pending: 'CHỜ XÁC NHẬN' , confirmed: 'CHỜ LẤY HÀNG' , shipping: 'ĐANG GIAO' ,
                        delivered: 'GIAO HÀNG THÀNH CÔNG' , cancelled: 'ĐÃ HỦY' }; %>
                        <% const colors={ pending: '#ff9800' , confirmed: '#0dcaf0' , shipping: '#2196f3' ,
                            delivered: '#4caf50' , cancelled: '#f44336' }; %>

                                <% orders.forEach(order=> { %>
                                <div class="order-card" data-status="<%= order.status %>">
                                    <!-- Shop Header -->
                                    <div class="order-card-header">
                                        <div class="fw-bold">
                                            <span class="badge bg-success me-2">Mall</span>
                                            <i class="fas fa-leaf text-success me-1"></i> <span class="fs-6">🌿 Plant
                                                Shop</span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <% if(order.status==='delivered' ) { %>
                                                <span class="text-success me-2 border-end pe-2"><i
                                                        class="fas fa-truck"></i> Giao hàng thành công</span>
                                                <% } %>
                                                    <span style="color: <%= colors[order.status] %>; font-weight: 600;">
                                                        <%= labels[order.status] %>
                                                    </span>
                                        </div>
                                    </div>

                                    <!-- Products -->
                                    <div class="order-card-body">
                                        <% order.items.forEach(item=> { %>
                                            <div class="product-item">
                                                <img src="<%= item.product_id?.image ? '/images/products/' + item.product_id.image : '/images/default.jpg' %>" alt="<%= item.name %>" class="product-img">
                                                <div class="product-info d-flex justify-content-between">
                                                    <div>
                                                        <div class=" fw-medium text-dark fs-6">
                                                                <%= item.name %>
                                                        </div>
                                                        <div class="text-muted small mt-1">Phân loại hàng: Mặc định</div>
                                                        <div class="text-muted small mt-1">x<%= item.quantity %>
                                                        </div>
                                                    </div>
                                <div class="text-end">
                                    <div class="text-dark fw-bold fs-6 mb-2">₫<%=
                                            parseInt(item.price).toLocaleString('vi-VN') %>
                                    </div>
                                    <% if (order.status==='delivered' ) { %>
                                        <% const pid=item.product_id && item.product_id._id ?
                                            item.product_id._id.toString() : (item.product_id ?
                                            item.product_id.toString() : '' ); const hasReviewed=reviewStatus ?
                                            reviewStatus[`${order._id}_${pid}`] : false; %>
                                            <% if (!hasReviewed) { %>
                                                <button class="btn btn-sm btn-outline-success btn-review"
                                                    onclick="event.stopPropagation(); openReviewModal('<%= pid %>', '<%= order._id %>', decodeURIComponent('<%= encodeURIComponent(item.name) %>'))"
                                                    style="font-size:13px; padding: 4px 12px; border-radius:4px;">
                                                    Đánh giá
                                                </button>
                                                <% } else { %>
                                                    <a href="/products/<%= pid %>#reviews"
                                                        onclick="event.stopPropagation();"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        style="font-size:13px; padding: 4px 12px; border-radius:4px;"
                                                        title="Xem lại đánh giá của bạn">Đã đánh giá</a>
                                                    <% } %>
                                                        <% } %>
                                </div>
                </div>
    </div>
    <% }) %>
        </div>

        <!-- Footer: Total & Actions -->
        <div class="order-card-footer">
            <div class="mb-3">
                <span class="text-dark fw-medium fs-6"><i class="fas fa-shield-alt text-success me-1"></i> Thành tiền:
                </span>
                <span class="order-total-price fw-bold">₫<%= parseInt(order.total_price).toLocaleString('vi-VN') %>
                </span>
            </div>

            <div class="d-flex justify-content-end gap-2 align-items-center">
                <div class="text-muted small me-auto d-none d-md-block">Mã đơn: #<%=
                        order._id.toString().slice(-8).toUpperCase() %>
                </div>

                <% let canRetryPayment=false; if (order.status==='pending' && order.payment_status==='unpaid' &&
                    ['vnpay', 'momo' ].includes(order.payment_method)) { const fifteenMinsAgo=new Date(Date.now() - 15 *
                    60 * 1000); if (new Date(order.createdAt)> fifteenMinsAgo) { canRetryPayment = true; } } %>

                    <% if (canRetryPayment) { %>
                        <form action="/orders/<%= order._id %>/retry-payment" method="POST" class="m-0">
                            <button type="submit" class="btn btn-success px-4 fw-bold">Thanh toán</button>
                        </form>
                        <% } %>

                            <!-- Buttons based on status -->
                            <a href="/orders/<%= order._id %>" class="btn btn-outline-secondary px-4">Xem chi tiết</a>
                            <% if (order.status === 'delivered') { %>
                                <button type="button" class="btn btn-outline-danger px-4" onclick="openReturnModal('<%= order._id %>')">Yêu cầu hoàn hàng</button>
                                <a href="/products" class="btn btn-success px-4">Mua lại</a>
                            <% } else if (order.status === 'return_requested') { %>
                                <button type="button" class="btn btn-warning px-4" disabled>Đang xử lý hoàn hàng</button>
                            <% } else if (order.status === 'returned') { %>
                                <button type="button" class="btn btn-secondary px-4" disabled>Đã hoàn hàng</button>
                            <% } else if (order.status === 'return_rejected') { %>
                                <button type="button" class="btn btn-danger px-4" disabled>Từ chối hoàn hàng</button>
                                <a href="/products" class="btn btn-success px-4">Mua lại</a>
                            <% } else if (order.status === 'cancelled') { %>
                                    <a href="/products" class="btn btn-success px-4">Mua lại</a>
                                    <% } else if (['pending', 'confirmed' ].includes(order.status)) { %>
                                        <a href="/orders/<%= order._id %>" class="btn btn-outline-secondary px-4">Đang
                                            xử lý</a>
                                        <% } else if (order.status==='shipping' ) { %>
                                            <a href="/orders/<%= order._id %>" class="btn btn-success px-4">Đã nhận được
                                                hàng</a>
                                            <% } %>
            </div>
        </div>
        </div>
        <% }) %>
            </div>
            <% } %>
                </div>

                <script src="/js/orders-list.js"></script>

                <!-- Return Request Modal -->
                <div class="modal fade" id="returnModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form id="returnForm">
                                <div class="modal-header">
                                    <h5 class="modal-title">Yêu cầu hoàn hàng</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" id="returnOrderId" name="orderId">
                                    <div class="mb-3">
                                        <label class="form-label text-dark fw-bold">Lý do hoàn hàng <span class="text-danger">*</span></label>
                                        <textarea class="form-control" name="reason" id="returnReason" rows="3" required placeholder="Ghi rõ lý do hoàn hàng (VD: Cây bị héo, chậu bị vỡ...)"></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-dark fw-bold">Hình ảnh minh chứng <span class="text-danger">*</span></label>
                                        <input type="file" name="images" id="returnImages" class="form-control" accept="image/*" multiple required onchange="previewReturnImages(this)">
                                        <small class="text-muted">Chọn tối đa 5 ảnh. Giữ Ctrl để chọn nhiều ảnh.</small>
                                        <div id="returnImagePreview" class="d-flex gap-2 flex-wrap mt-2"></div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-danger" id="btnSubmitReturn">Gửi yêu cầu</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Modal Đánh giá -->
                <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius: 12px; background-color: #F9F8F6;">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold" id="reviewModalLabel">Đánh giá <span
                                        id="reviewProductName" class="text-success"></span></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form id="reviewForm">
                                    <input type="hidden" id="reviewProductId" name="product_id">
                                    <input type="hidden" id="reviewOrderId" name="order_id">

                                    <div class="text-center mb-4">
                                        <div class="fs-1" id="starRatingContainer"
                                            style="color: #FFBF00; cursor: pointer;">
                                            <i class="far fa-star" data-value="1"></i>
                                            <i class="far fa-star" data-value="2"></i>
                                            <i class="far fa-star" data-value="3"></i>
                                            <i class="far fa-star" data-value="4"></i>
                                            <i class="far fa-star" data-value="5"></i>
                                        </div>
                                        <input type="hidden" id="reviewRating" name="rating" required>
                                        <div class="text-muted mt-1" id="ratingText">Vui lòng chọn số sao</div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Trải nghiệm của bạn</label>
                                        <div class="d-flex flex-wrap gap-2" id="reviewTagsContainer">
                                            <span class="badge rounded-pill border review-tag"
                                                data-tag="🌿 Cây tươi khỏe"
                                                style="cursor:pointer; color:#198754; background:#e8f5e9; border-color:#198754!important; opacity: 0.5;">🌿
                                                Cây tươi khỏe</span>
                                            <span class="badge rounded-pill border review-tag"
                                                data-tag="📦 Đóng gói cẩn thận"
                                                style="cursor:pointer; color:#795548; background:#efebe9; border-color:#795548!important; opacity: 0.5;">📦
                                                Đóng gói cẩn thận</span>
                                            <span class="badge rounded-pill border review-tag"
                                                data-tag="🚚 Giao hàng nhanh"
                                                style="cursor:pointer; color:#0d6efd; background:#e3f2fd; border-color:#0d6efd!important; opacity: 0.5;">🚚
                                                Giao hàng nhanh</span>
                                            <span class="badge rounded-pill border review-tag"
                                                data-tag="🌟 Hình dáng đẹp"
                                                style="cursor:pointer; color:#FFBF00; background:#fff8e1; border-color:#FFBF00!important; opacity: 0.5;">🌟
                                                Hình dáng đẹp</span>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="reviewComment" class="form-label fw-bold">Chi tiết đánh giá (không
                                            bắt buộc)</label>
                                        <textarea class="form-control" id="reviewComment" name="comment" rows="3"
                                            placeholder="Chia sẻ cảm nhận của bạn về sản phẩm..."
                                            style="border-radius: 8px;"></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-success w-100 fw-bold"
                                        style="border-radius: 8px;">Gửi đánh giá</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <%- include('../layouts/footer') %>