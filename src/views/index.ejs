<%- include('layouts/header') %>

    <style>
        /* Hero Section */
        .hero-section {
            height: 700px;
            background: linear-gradient(rgba(26, 46, 35, 0.4), rgba(45, 95, 63, 0.8)), url('/images/products/mon-rong-bac.jpg') center/cover;
            display: flex;
            align-items: center;
            color: white;
        }

        .hero-title {
            font-size: 56px;
            font-weight: 600;
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .hero-subtitle {
            font-size: 18px;
            font-weight: 300;
            margin-bottom: 2.5rem;
            opacity: 0.9;
        }

        /* Category Cards */
        .cat-card {
            position: relative;
            border-radius: var(--radius-lg);
            overflow: hidden;
            height: 350px;
        }

        .cat-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .cat-card-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 30px 20px;
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
            color: white;
            text-align: center;
        }

        .cat-card:hover img {
            transform: scale(1.05);
        }

        /* Product Cards */
        .lux-product-card {
            background: #fff;
            border-radius: var(--radius-md);
            overflow: hidden;
            transition: var(--transition);
            border: 1px solid var(--border-light);
        }

        .lux-product-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-5px);
        }

        .lux-product-image {
            position: relative;
            height: 280px;
        }

        .lux-product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .lux-quick-actions {
            position: absolute;
            bottom: -60px;
            left: 0;
            right: 0;
            display: flex;
            justify-content: center;
            gap: 10px;
            transition: 0.3s;
            background: rgba(255, 255, 255, 0.95);
            padding: 12px;
        }

        .lux-product-card:hover .lux-quick-actions {
            bottom: 0;
        }

        /* Features */
        .feature-box {
            text-align: center;
            padding: 40px 20px;
            background: #fff;
            border-radius: var(--radius-lg);
            height: 100%;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .feature-box:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

        .feature-icon {
            font-size: 40px;
            color: var(--secondary);
            margin-bottom: 20px;
        }

        /* Banner */
        .promo-banner {
            background: linear-gradient(135deg, #f0f7f3 0%, #d8ede4 100%);
            border-radius: var(--radius-xl);
            overflow: hidden;
        }

        /* Blog */
        .blog-card img {
            height: 220px;
            object-fit: cover;
            border-radius: var(--radius-md) var(--radius-md) 0 0;
        }

        /* Newsletter */
        .newsletter-section {
            background: var(--primary);
            color: white;
            padding: 80px 0;
            text-align: center;
        }

        .newsletter-form .form-control {
            border-radius: 50px 0 0 50px;
            padding-left: 25px;
            border: none;
        }

        .newsletter-form .btn {
            border-radius: 0 50px 50px 0;
        }

        .hover-opacity-100 {
            opacity: 0;
        }

        .hover-opacity-100:hover {
            opacity: 1 !important;
        }
    </style>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container text-center text-md-start">
            <div class="row">
                <div class="col-lg-7">
                    <h1 class="hero-title font-serif">Mang Thiên Nhiên Vào Không Gian Sống</h1>
                    <p class="hero-subtitle">Bộ sưu tập cây cảnh cao cấp - Chất lượng đảm bảo - Giao hàng toàn quốc</p>
                    <div class="d-flex gap-3 justify-content-center justify-content-md-start">
                        <a href="/products" class="btn btn-success btn-lg px-4 shadow">Khám Phá Ngay</a>
                        <a href="/admin/chat" class="btn btn-outline-light btn-lg px-4">Tư Vấn Miễn Phí</a>
                    </div>
                    <div
                        class="mt-4 pt-3 border-top border-light border-opacity-25 d-flex gap-4 justify-content-center justify-content-md-start small">
                        <span><i class="fas fa-truck me-2" style="color: var(--secondary);"></i>Miễn phí vận
                            chuyển</span>
                        <span><i class="fas fa-shield-alt me-2" style="color: var(--secondary);"></i>Bảo hành cây</span>
                        <span><i class="fas fa-headset me-2" style="color: var(--secondary);"></i>Tư vấn 24/7</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Categories -->
    <section class="py-5 mt-4">
        <div class="container py-4">
            <h2 class="text-center font-serif mb-5 display-6 fw-bold">Danh Mục Nổi Bật</h2>
            <div class="row g-4">
                <% const catImages=['trau-ba.jpg', 'kim-tien.jpg' , 'xuong-rong.jpg' , 'rau-ma.jpg' ]; const
                    catIcons=['fa-leaf', 'fa-seedling' , 'fa-tree' , 'fa-spa' ]; globalCategories.slice(0,
                    4).forEach((cat, index)=> {
                    const img = catImages[index % catImages.length];
                    const icon = catIcons[index % catIcons.length];
                    %>
                    <div class="col-md-6 col-lg-3">
                        <a href="/products?category=<%= cat._id %>" class="d-block text-decoration-none">
                            <div class="cat-card shadow-sm">
                                <img src="/images/products/<%= img %>" alt="<%= cat.name %>">
                                <div class="cat-card-overlay">
                                    <i class="fas <%= icon %> fs-3 mb-2" style="color: var(--secondary);"></i>
                                    <h5 class="mb-0 font-serif text-white">
                                        <%= cat.name %>
                                    </h5>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }) %>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section class="py-5 bg-white">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="font-serif display-6 fw-bold">Sản Phẩm Nổi Bật</h2>
                <p class="text-muted fs-5">Những cây cảnh được yêu thích nhất</p>
            </div>

            <div class="row g-4">
                <% let allProducts=[]; categoriesWithProducts.forEach(cat=> allProducts.push(...cat.products));
                    allProducts = allProducts.sort(() => 0.5 - Math.random()).slice(0, 8);
                    allProducts.forEach(product => {
                    %>
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="lux-product-card h-100 position-relative">
                            <% if (product.stock===0) { %>
                                <span class="badge bg-danger position-absolute top-0 end-0 m-3 z-1">Hết hàng</span>
                                <% } else if (Math.random()> 0.6) { %>
                                    <span class="badge position-absolute top-0 end-0 m-3 z-1"
                                        style="background: var(--secondary);">Hot</span>
                                    <% } %>

                                        <div class="lux-product-image">
                                            <img src="/images/products/<%= product.image %>" alt="<%= product.name %>"
                                                onerror="this.src='/images/default.jpg'">
                                            <div class="lux-quick-actions">
                                                <button class="btn btn-outline-secondary rounded-circle btn-wishlist"
                                                    style="width: 40px; height: 40px;" data-id="<%= product._id %>"
                                                    title="Yêu thích"><i class="far fa-heart"></i></button>
                                                <a href="/products/<%= product._id %>"
                                                    class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                                                    style="width: 40px; height: 40px;" title="Xem chi tiết"><i
                                                        class="fas fa-eye"></i></a>
                                                <% if (product.stock> 0) { %>
                                                    <button class="btn btn-success rounded-circle btn-add-cart"
                                                        style="width: 40px; height: 40px;" data-id="<%= product._id %>"
                                                        title="Thêm giỏ hàng"><i class="fas fa-cart-plus"></i></button>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <div class="p-4 text-center">
                                            <div class="text-warning small mb-2">
                                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                                    class="fas fa-star"></i><i class="fas fa-star"></i><i
                                                    class="fas fa-star-half-alt"></i>
                                            </div>
                                            <h6 class="mb-2 text-truncate font-serif fs-5"><a
                                                    href="/products/<%= product._id %>" class="text-dark">
                                                    <%= product.name %>
                                                </a></h6>
                                            <div class="fw-bold fs-5" style="color: var(--primary);">
                                                <%= parseInt(product.price).toLocaleString('vi-VN') %>đ
                                            </div>
                                        </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <div class="text-center mt-5">
                <a href="/products" class="btn btn-outline-success px-5 py-3 rounded-pill text-uppercase"
                    style="letter-spacing: 1px; font-weight: 600;">Xem Tất Cả Sản Phẩm</a>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-5" style="background-color: var(--bg-light);">
        <div class="container py-5">
            <h2 class="text-center font-serif mb-5 display-6 fw-bold">Vì Sao Chọn Plant Shop</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="fas fa-truck-fast feature-icon"></i>
                        <h4 class="font-serif fw-bold mb-3">Giao Hàng Toàn Quốc</h4>
                        <p class="text-muted mb-0">Đóng gói chuyên nghiệp, đảm bảo cây đến tay bạn luôn xanh tươi và
                            nguyên vẹn trong suốt quá trình vận chuyển.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="fas fa-award feature-icon"></i>
                        <h4 class="font-serif fw-bold mb-3">Cây Chất Lượng Cao</h4>
                        <p class="text-muted mb-0">Tuyển chọn kỹ lưỡng từ nhà vườn, đã được ươm dưỡng ổn định trước khi
                            giao đến tay khách hàng.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-box">
                        <i class="fas fa-sync feature-icon"></i>
                        <h4 class="font-serif fw-bold mb-3">Đổi Trả Dễ Dàng</h4>
                        <p class="text-muted mb-0">Cam kết hoàn tiền hoặc đổi cây mới nếu cây bị hư hỏng, không đạt yêu
                            cầu chất lượng như đã thỏa thuận.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Promo Banner -->
    <section class="py-5 bg-white">
        <div class="container py-4">
            <div class="promo-banner row align-items-center g-0">
                <div class="col-md-6 order-2 order-md-1 p-5 text-center text-md-start">
                    <span class="badge mb-3 px-3 py-2 text-dark" style="background: var(--secondary-light);">Ưu Đãi Đặc
                        Biệt</span>
                    <h2 class="font-serif display-4 fw-bold mb-4" style="color: var(--primary-dark);">Giảm 30% Cho Đơn
                        Hàng Đầu Tiên</h2>
                    <p class="text-muted mb-4 fs-5">Làm mới không gian sống của bạn với những chậu cây tuyệt đẹp. Nhập
                        mã <strong>WELCOME30</strong> khi thanh toán.</p>
                    <a href="/products" class="btn btn-success btn-lg px-5 rounded-pill shadow">Mua Ngay</a>
                </div>
                <div class="col-md-6 order-md-1">
                    <img src="/images/products/hoa-hong.jpg" class="img-fluid w-100 object-fit-cover"
                        style="height: 500px; border-radius: var(--radius-lg); box-shadow: var(--shadow-md);">
                </div>
            </div>
        </div>
    </section>

    <!-- Blog Section -->
    <section class="py-5" style="background-color: var(--bg-light);">
        <div class="container py-5">
            <h2 class="text-center font-serif mb-5 display-6 fw-bold">Cẩm Nang Cây Xanh</h2>
            <div class="row g-4">
                <% if (latestArticles && latestArticles.length > 0) { %>
                    <% latestArticles.forEach(article => { %>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 blog-card">
                                <a href="/blogs/<%= article.slug %>" class="d-block overflow-hidden" style="height: 220px;">
                                    <img src="/images/products/<%= article.image %>" alt="<%= article.title %>" class="w-100 h-100" style="object-fit: cover; transition: transform 0.5s ease;" onerror="this.src='/images/default-article.jpg'">
                                </a>
                                <div class="card-body p-4 d-flex flex-column">
                                    <h4 class="card-title font-serif fw-bold" style="font-size: 1.1rem; line-height: 1.4;">
                                        <a href="/blogs/<%= article.slug %>" class="text-dark text-decoration-none article-title-link">
                                            <%= article.title %>
                                        </a>
                                    </h4>
                                    <p class="text-muted small mb-3"><i class="far fa-calendar-alt me-1"></i><%= new Date(article.createdAt).toLocaleDateString('vi-VN') %></p>
                                    <p class="card-text text-muted flex-grow-1" style="font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                        <%= article.summary %>
                                    </p>
                                    <a href="/blogs/<%= article.slug %>" class="text-decoration-none fw-bold mt-3" style="color: var(--secondary);">Đọc thêm &rarr;</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center text-muted py-4">Chưa có bài viết mới.</div>
                <% } %>
            </div>
            <div class="text-center mt-5">
                <a href="/blogs" class="btn btn-outline-secondary px-5 py-3 rounded-pill text-uppercase"
                    style="letter-spacing: 1px; font-weight: 600;">Xem Tất Cả Bài Viết</a>
            </div>
        </div>
    </section>

    <!-- Instagram Gallery -->
    <section class="py-5 bg-white">
        <div class="container-fluid px-0">
            <div class="text-center mb-4">
                <h2 class="font-serif display-6 fw-bold">Cảm Hứng Từ Khách Hàng</h2>
                <a href="#" class="text-muted text-decoration-none fs-5"><i
                        class="fab fa-instagram me-2"></i>@plantshop.vn</a>
            </div>
            <div class="row g-0">
                <% const instaImgs=['hoa-do-quyen.jpg', 'mon-rong-bac.jpg' , 'kimtien1.jpg' , 'lan-y.jpg'
                    , 'hoa-tu-dang.jpg' , 'cau-tieu-tram.jpg' ]; %>
                    <% instaImgs.forEach(img=> { %>
                        <div class="col-4 col-md-2">
                            <a href="#" class="d-block position-relative overflow-hidden" style="height: 250px;">
                                <img src="/images/products/<%= img %>" class="w-100 h-100 object-fit-cover" alt="Instagram">
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center hover-opacity-100"
                                    style="background: rgba(45,95,63,0.7); transition: 0.3s; cursor: pointer;">
                                    <i class="fab fa-instagram text-white display-4"></i>
                                </div>
                            </a>
                        </div>
                    <% }) %>
            </div>
        </div>
    </section>

    <!-- Newsletter -->
    <section class="newsletter-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <i class="far fa-envelope-open display-4 mb-4" style="color: var(--secondary);"></i>
                    <h2 class="font-serif mb-3 fw-bold">Đăng Ký Nhận Ưu Đãi Đặc Biệt</h2>
                    <p class="mb-5 fs-5" style="color: rgba(255,255,255,0.8);">Nhận ngay mã giảm giá 10% và tips chăm sóc cây mỗi tuần</p>
                    <form class="newsletter-form d-flex shadow-lg" id="newsletterForm">
                        <input type="email" name="email" id="newsletterEmail" class="form-control form-control-lg py-3" placeholder="Nhập địa chỉ email của bạn..." required>
                        <button type="submit" class="btn btn-dark btn-lg px-5 fw-bold" style="background: var(--primary-dark);">Đăng Ký</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include('layouts/footer') %>

    <script>
        document.getElementById('newsletterForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const emailInput = document.getElementById('newsletterEmail');
            const email = emailInput.value;
            const submitBtn = this.querySelector('button[type="submit"]');
            
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            try {
                const response = await fetch('/newsletter/subscribe', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email: email })
                });

                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message, 'success');
                    emailInput.value = '';
                } else {
                    showToast(data.message, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Có lỗi xảy ra, vui lòng thử lại sau', 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Đăng Ký';
            }
        });
    </script>