<% extraJS = ['/js/main.js'] %>
<%- include('layouts/header') %>

<!-- Hero Banner -->
<div class="hero-banner rounded-3 mb-5 p-5 text-white text-center">
    <h1 class="display-4 fw-bold">🌿 Chào mừng đến Plant Shop</h1>
    <p class="lead">Cây cảnh đẹp, giá tốt - Mang thiên nhiên vào ngôi nhà bạn</p>
    <a href="/products" class="btn btn-light btn-lg px-4">Mua ngay</a>
</div>

<!-- Tab + Carousel -->
<div class="mb-5">

    <!-- Tiêu đề + tabs -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <h3 class="fw-bold mb-0">🌱 Sản phẩm theo danh mục</h3>
        <a href="/products" class="view-all-link">
            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="category-tabs mb-4">
        <% categoriesWithProducts.forEach((cat, i) => { %>
        <button class="tab-btn <%= i === 0 ? 'active' : '' %>"
                id="tab-<%= cat._id %>"
                data-cat="<%= cat._id %>"
                onclick="switchTab('<%= cat._id %>')">
            <%= cat.name %>
        </button>
        <% }) %>
    </div>

    <!-- Panels -->
    <% categoriesWithProducts.forEach((cat, catIndex) => { %>
    <div class="cat-panel <%= catIndex === 0 ? 'active' : '' %>" id="panel-<%= cat._id %>">

        <% if (cat.products.length === 0) { %>
        <div class="text-center text-muted py-5">
            <div class="fs-2">🌵</div>
            <p class="mt-2 mb-0">Chưa có sản phẩm trong danh mục này</p>
        </div>
        <% } else { %>

        <div class="carousel-wrapper">
            <button class="carousel-btn prev hidden" id="prev-<%= cat._id %>"
                    onclick="carouselSlide('<%= cat._id %>', -1)">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="carousel-outer" id="outer-<%= cat._id %>">
                <div class="carousel-track" id="track-<%= cat._id %>">
                    <% cat.products.forEach(product => { %>
                    <div class="carousel-slide">
                        <div class="card product-card h-100">
                            <div class="position-relative overflow-hidden">
                                <img src="/images/products/<%= product.image %>"
                                     class="card-img-top"
                                     alt="<%= product.name %>"
                                     onerror="this.src='/images/default.jpg'">
                                <% if (product.stock === 0) { %>
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">Hết hàng</span>
                                <% } else if (product.stock < 10) { %>
                                    <span class="badge bg-warning position-absolute top-0 end-0 m-2">Còn ít</span>
                                <% } %>
                            </div>
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title mb-1"
                                    style="overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; font-size:14px;">
                                    <%= product.name %>
                                </h6>
                                <p class="text-success fw-bold mt-auto mb-2 mb-0">
                                    <%= parseInt(product.price).toLocaleString('vi-VN') %>đ
                                </p>
                                <div class="d-flex gap-1 mt-2">
                                    <a href="/products/<%= product._id %>"
                                       class="btn btn-outline-success btn-sm flex-fill">
                                        Chi tiết
                                    </a>
                                    <% if (product.stock > 0) { %>
                                    <button class="btn btn-success btn-sm btn-add-cart"
                                            data-id="<%= product._id %>">
                                        <i class="fas fa-cart-plus"></i>
                                    </button>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </div>

            <button class="carousel-btn next" id="next-<%= cat._id %>"
                    onclick="carouselSlide('<%= cat._id %>', 1)">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

        <div class="carousel-dots" id="dots-<%= cat._id %>"></div>

        <div class="text-end mt-3">
            <a href="/products?category=<%= cat._id %>" class="view-all-link">
                Xem tất cả <%= cat.name %> <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <% } %>
    </div>
    <% }) %>
</div>

<!-- Banner dịch vụ -->
<div class="row mt-2 mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-0 bg-light text-center p-4">
            <div class="fs-1">🚚</div>
            <h6 class="fw-bold mt-2">Giao hàng toàn quốc</h6>
            <small class="text-muted">Đóng gói cẩn thận, giao tận nơi</small>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 bg-light text-center p-4">
            <div class="fs-1">🌿</div>
            <h6 class="fw-bold mt-2">Cây chất lượng cao</h6>
            <small class="text-muted">Cây khỏe mạnh, được chăm sóc kỹ</small>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 bg-light text-center p-4">
            <div class="fs-1">💯</div>
            <h6 class="fw-bold mt-2">Đổi trả dễ dàng</h6>
            <small class="text-muted">Hoàn tiền nếu cây không đạt yêu cầu</small>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>