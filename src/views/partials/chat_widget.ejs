<% if (locals.user && locals.user.role === 'user') { %>
<div id="customer-chat-widget" class="chat-widget">
    <!-- Nút bong bóng chat -->
    <button id="chat-toggle-btn" class="chat-toggle-btn shadow">
        <i class="fas fa-comments fs-4"></i>
        <span id="chat-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
            1
        </span>
    </button>

    <!-- Cửa sổ chat -->
    <div id="chat-window" class="chat-window shadow-lg d-none">
        <div class="chat-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 text-white"><i class="fas fa-headset me-2"></i>Hỗ trợ trực tuyến</h6>
            <button id="chat-close-btn" class="btn btn-sm text-white"><i class="fas fa-times"></i></button>
        </div>
        <div id="chat-body" class="chat-body">
            <!-- Tin nhắn sẽ được append vào đây -->
            <div class="text-center text-muted small mt-2">Xin chào! Chúng tôi có thể giúp gì cho bạn?</div>
        </div>
        <div class="chat-footer">
            <form id="chat-form" class="d-flex">
                <input type="text" id="chat-input" class="form-control form-control-sm" placeholder="Nhập tin nhắn..." autocomplete="off" required>
                <button type="submit" class="btn btn-success btn-sm ms-2"><i class="fas fa-paper-plane"></i></button>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/css/chat-widget.css">
<script src="/js/chat_widget.js"></script>
<% } %>
