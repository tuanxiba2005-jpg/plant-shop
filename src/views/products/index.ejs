<%- include('../layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">
        Tìm thấy <span class="text-success fw-bold"><%= total %></span> sản phẩm
        <% if (keyword) { %>
            <small class="text-muted fw-normal"> cho "<%= keyword %>"</small>
        <% } %>
        <% if (selectedCategory) { %>
            <small class="text-muted fw-normal"> · <a href="/products" class="text-success">Xóa bộ lọc</a></small>
        <% } %>
    </h5>
</div>

<% if (products.length === 0) { %>
<div class="text-center py-5">
    <div class="fs-1">🌵</div>
    <h5 class="text-muted">Không tìm thấy sản phẩm nào</h5>
    <a href="/products" class="btn btn-success mt-2">Xem tất cả</a>
</div>
<% } else { %>
<div class="row">
    <% products.forEach(product => { %>
    <div class="col-6 col-md-3 mb-4">
        <div class="card h-100 shadow-sm product-card position-relative">
            <button class="btn btn-wishlist position-absolute top-0 start-0 m-2 border-0 bg-transparent"
                    style="z-index: 10; color: rgba(255, 255, 255, 0.8);"
                    data-id="<%= product._id %>" title="Thêm vào yêu thích">
                <i class="far fa-heart fs-5" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);"></i>
            </button>
            <img src="/images/products/<%= product.image %>"
                 class="card-img-top"
                 alt="<%= product.name %>"
                 style="height:180px; object-fit:contain;"
                 onerror="this.src='/images/default.jpg'">
            <div class="card-body d-flex flex-column">
                <h6 class="card-title"><%= product.name %></h6>
                <small class="text-muted"><%= product.category_name %></small>
                <% if (product.stock === 0) { %>
                    <span class="badge bg-danger mt-1" style="width:fit-content">Hết hàng</span>
                <% } else if (product.stock < 10) { %>
                    <span class="badge bg-warning mt-1" style="width:fit-content">Còn ít</span>
                <% } %>
                <p class="text-success fw-bold mt-auto mb-2">
                    <%= parseInt(product.price).toLocaleString('vi-VN') %>đ
                </p>
                <div class="d-flex gap-1">
                    <a href="/products/<%= product._id %>"
                       class="btn btn-outline-success btn-sm flex-fill">
                       Chi tiết
                    </a>
                    <% if (product.stock > 0) { %>
                    <button class="btn btn-success btn-sm btn-add-cart"
                            data-id="<%= product._id %>">
                        <i class="fas fa-cart-plus"></i>
                    </button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <% }) %>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
<nav class="mt-3">
    <ul class="pagination justify-content-center">
        <% if (currentPage > 1) { %>
        <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage - 1 %>&category=<%= selectedCategory || '' %>&search=<%= keyword %>">
                &laquo;
            </a>
        </li>
        <% } %>
        <% for(let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %>&category=<%= selectedCategory || '' %>&search=<%= keyword %>">
                <%= i %>
            </a>
        </li>
        <% } %>
        <% if (currentPage < totalPages) { %>
        <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage + 1 %>&category=<%= selectedCategory || '' %>&search=<%= keyword %>">
                &raquo;
            </a>
        </li>
        <% } %>
    </ul>
</nav>
<% } %>
<% } %>

<%- include('../layouts/footer') %>