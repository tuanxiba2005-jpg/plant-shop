<%- include('../../layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">🏷️ Quản lý Giảm giá Sản phẩm</h4>
    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#addDiscountModal">
        <i class="fas fa-plus me-2"></i>Thêm giảm giá
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-danger">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá gốc</th>
                        <th>Giá đang bán (Sau giảm)</th>
                        <th>Mức giảm (%)</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% discountedProducts.forEach(p => { 
                        const percent = Math.round(100 - (p.price / p.original_price * 100));
                    %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="/images/products/<%= p.image %>" width="40" height="40" class="rounded me-2" style="object-fit:cover;">
                                    <span class="fw-bold"><%= p.name %></span>
                                </div>
                            </td>
                            <td class="text-muted text-decoration-line-through">
                                <%= p.original_price.toLocaleString('vi-VN') %>đ
                            </td>
                            <td class="text-danger fw-bold fs-5">
                                <%= p.price.toLocaleString('vi-VN') %>đ
                            </td>
                            <td>
                                <span class="badge bg-danger">Giảm <%= percent %>%</span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" onclick="removeDiscount('<%= p._id %>')">
                                    <i class="fas fa-times"></i> Huỷ giảm giá
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (discountedProducts.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có sản phẩm nào đang giảm giá</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Giảm giá -->
<div class="modal fade" id="addDiscountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Thêm chương trình giảm giá</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="discountError" class="alert alert-danger d-none"></div>
                
                <div class="mb-3">
                    <label class="form-label">Chọn sản phẩm</label>
                    <select id="productSelect" class="form-select" onchange="previewDiscount()">
                        <option value="">-- Chọn sản phẩm --</option>
                        <% allProducts.forEach(p => { %>
                            <option value="<%= p._id %>" data-price="<%= p.original_price || p.price %>">
                                <%= p.name %> (Giá gốc: <%= (p.original_price || p.price).toLocaleString('vi-VN') %>đ)
                            </option>
                        <% }) %>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Giá sau khi giảm (VNĐ)</label>
                    <input type="number" id="newPriceInput" class="form-control" placeholder="Ví dụ: 99000" oninput="previewDiscount()">
                </div>

                <div class="alert alert-info" id="previewBox" style="display: none;">
                    <strong>Xem trước:</strong><br>
                    Giá gốc: <span id="prevOriginal" class="text-decoration-line-through text-muted"></span><br>
                    Sẽ bán với giá: <span id="prevNew" class="text-danger fw-bold"></span><br>
                    Tương đương mức giảm: <span id="prevPercent" class="badge bg-danger fs-6"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger" onclick="saveDiscount()">Áp dụng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function previewDiscount() {
        const select = document.getElementById('productSelect');
        const priceInput = document.getElementById('newPriceInput').value;
        const previewBox = document.getElementById('previewBox');
        
        if (select.selectedIndex <= 0 || !priceInput) {
            previewBox.style.display = 'none';
            return;
        }

        const option = select.options[select.selectedIndex];
        const originalPrice = Number(option.getAttribute('data-price'));
        const newPrice = Number(priceInput);

        if (newPrice > 0 && newPrice < originalPrice) {
            document.getElementById('prevOriginal').textContent = originalPrice.toLocaleString('vi-VN') + 'đ';
            document.getElementById('prevNew').textContent = newPrice.toLocaleString('vi-VN') + 'đ';
            const percent = Math.round(100 - (newPrice / originalPrice * 100));
            document.getElementById('prevPercent').textContent = 'Giảm ' + percent + '%';
            previewBox.style.display = 'block';
        } else {
            previewBox.style.display = 'none';
        }
    }

    async function saveDiscount() {
        const product_id = document.getElementById('productSelect').value;
        const new_price = document.getElementById('newPriceInput').value;
        const errDiv = document.getElementById('discountError');

        if (!product_id || !new_price) {
            errDiv.textContent = 'Vui lòng chọn sản phẩm và nhập giá giảm';
            errDiv.classList.remove('d-none');
            return;
        }

        try {
            const res = await fetch('/admin/discounts/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ product_id, new_price })
            });
            const data = await res.json();
            
            if (data.success) {
                location.reload();
            } else {
                errDiv.textContent = data.message;
                errDiv.classList.remove('d-none');
            }
        } catch (err) {
            errDiv.textContent = 'Lỗi kết nối';
            errDiv.classList.remove('d-none');
        }
    }

    async function removeDiscount(id) {
        if (!confirm('Bạn có chắc chắn muốn huỷ giảm giá cho sản phẩm này? Giá sẽ quay về mức ban đầu.')) return;
        
        try {
            const res = await fetch(`/admin/discounts/${id}/remove`, { method: 'POST' });
            const data = await res.json();
            
            if (data.success) {
                location.reload();
            } else {
                alert(data.message);
            }
        } catch (err) {
            alert('Lỗi kết nối');
        }
    }
</script>

<%- include('../../layouts/footer') %>
