<% extraJS=['/js/admin/dashboard.js']; extraCSS=['/css/admin-dashboard.css'] %>
    <%- include('../layouts/header') %>

        <div class="admin-layout">
            <!-- Dark Sidebar -->
            <aside class="admin-sidebar shadow-lg">
                <a href="/" class="brand d-flex align-items-center">
                    <i class="fas fa-leaf me-2"></i> Plant Shop
                </a>
                <div class="nav-menu">
                    <a href="/admin/dashboard" class="nav-item active">
                        <i class="fas fa-tachometer-alt"></i> Tổng quan
                    </a>
                    <a href="/admin/products" class="nav-item">
                        <i class="fas fa-box-open"></i> Sản phẩm
                    </a>
                    <a href="/admin/categories" class="nav-item">
                        <i class="fas fa-folder"></i> Danh mục
                    </a>
                    <a href="/admin/orders" class="nav-item">
                        <i class="fas fa-shopping-bag"></i> Đơn hàng
                    </a>
                    <a href="/admin/users" class="nav-item">
                        <i class="fas fa-users"></i> Người dùng
                    </a>
                    <a href="/admin/shifts" class="nav-item">
                        <i class="fas fa-calendar-alt"></i> Phân ca làm việc
                    </a>
                    <a href="/admin/revenue" class="nav-item">
                        <i class="fas fa-chart-line"></i> Doanh thu
                    </a>
                    <a href="/admin/discounts" class="nav-item">
                        <i class="fas fa-percent"></i> Khuyến mãi SP
                    </a>
                    <a href="/admin/coupons" class="nav-item">
                        <i class="fas fa-tags"></i> Mã giảm giá
                    </a>
                    <a href="/admin/articles" class="nav-item">
                        <i class="fas fa-newspaper"></i> Bài viết
                    </a>
                    <a href="/user/logout" class="nav-item text-danger mt-auto pt-3 border-top">
                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                    </a>
                </div>
                <div class="bottom-menu">
                    <a href="/admin/chat" class="nav-item">
                        <i class="fas fa-headset text-success"></i> Hỗ trợ Chat
                    </a>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="admin-main">
                <!-- Topbar -->
                <header class="admin-topbar">
                    <div class="d-flex align-items-center">
                        <h4 class="mb-0 fw-bold text-dark">Dashboard</h4>
                    </div>

                </header>

                <!-- Content Area -->
                <div class="admin-content">

                    <!-- Plant Image Cards (Top Products) -->
                    <div class="row mb-4 g-3">
                        <% if (typeof topProducts !=='undefined' && topProducts.length> 0) { %>
                            <% topProducts.forEach((product, index)=> { %>
                                <div class="col-md-3">
                                    <div class="plant-card">
                                        <img src="/images/products/<%= product.image %>" alt="<%= product.name %>">
                                        <div class="overlay">
                                            <h5 class="fw-bold mb-1 text-truncate">
                                                <%= product.name %>
                                            </h5>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="small"><i class="fas fa-box me-1"></i>Kho: <%=
                                                        product.stock %></span>
                                                <span class="badge bg-success bg-opacity-75">
                                                    <%= parseInt(product.price).toLocaleString('vi-VN') %>đ
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="col-12 text-muted">Chưa có sản phẩm nào.</div>
                                        <% } %>
                    </div>

                    <!-- Stats & Charts -->
                    <div class="row mb-4 g-3">
                        <div class="col-md-3">
                            <div class="d-flex flex-column gap-3 h-100">
                                <div class="stat-card p-4">
                                    <div class="icon-box icon-box-success">
                                        <i class="fas fa-wallet"></i>
                                    </div>
                                    <h3 class="fw-bold mb-1">
                                        <%= parseInt(totalRevenue).toLocaleString('vi-VN') %>đ
                                    </h3>
                                    <p class="text-muted small mb-0">Tổng doanh thu</p>
                                </div>
                                <div class="stat-card p-4">
                                    <div class="icon-box icon-box-warning">
                                        <i class="fas fa-shopping-cart"></i>
                                    </div>
                                    <h3 class="fw-bold mb-1">
                                        <%= totalOrders %>
                                    </h3>
                                    <p class="text-muted small mb-0">Tổng đơn hàng</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="fw-bold mb-0">Biểu đồ doanh thu <%= new Date().getFullYear() %>
                                    </h5>
                                    <a href="/admin/revenue" class="btn btn-sm btn-light border">Báo cáo chi tiết <i
                                            class="fas fa-chevron-right ms-1"></i></a>
                                </div>
                                <div style="position: relative; height: 300px; width: 100%;">
                                    <canvas id="dashboardChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Orders Table -->
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">Đơn hàng gần đây</h5>
                                <a href="/admin/orders" class="text-success text-decoration-none small fw-bold">Xem tất
                                    cả →</a>
                            </div>
                            <div class="table-responsive">
                                <table class="modern-table">
                                    <thead>
                                        <tr>
                                            <th>Khách hàng</th>
                                            <th>Mã đơn</th>
                                            <th>Ngày đặt</th>
                                            <th>Tổng tiền</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (recentOrders.length===0) { %>
                                            <tr>
                                                <td colspan="5" class="text-center text-muted">Chưa có đơn hàng nào</td>
                                            </tr>
                                            <% } else { %>
                                                <% const badges={ pending: 'warning' , confirmed: 'info' ,
                                                    shipping: 'primary' , delivered: 'success' , cancelled: 'danger' }
                                                    %>
                                                    <% const labels={ pending: 'Chờ xác nhận' , confirmed: 'Đã xác nhận'
                                                        , shipping: 'Đang giao' , delivered: 'Đã giao' ,
                                                        cancelled: 'Đã hủy' } %>
                                                        <% recentOrders.forEach(order=> { %>
                                                            <tr>
                                                                <td>
                                                                    <div class="d-flex align-items-center">
                                                                        <div
                                                                            class="bg-light rounded-circle p-2 me-3 text-success">
                                                                            <i class="fas fa-user"></i>
                                                                        </div>
                                                                        <div>
                                                                            <h6 class="mb-0 fw-bold">
                                                                                <%= order.user_id?.name
                                                                                    || 'Khách vãng lai' %>
                                                                            </h6>
                                                                            <small class="text-muted">
                                                                                <%= order.user_id?.email || '' %>
                                                                            </small>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td class="fw-bold text-muted">#<%=
                                                                        order._id.toString().slice(-6).toUpperCase() %>
                                                                </td>
                                                                <td>
                                                                    <%= new
                                                                        Date(order.createdAt).toLocaleDateString('vi-VN')
                                                                        %>
                                                                </td>
                                                                <td class="fw-bold text-success">
                                                                    <%= parseInt(order.total_price).toLocaleString('vi-VN')
                                                                        %>đ
                                                                </td>
                                                                <td>
                                                                    <span
                                                                        class="badge rounded-pill badge-soft-<%= badges[order.status] %> px-3 py-2">
                                                                        <%= labels[order.status] %>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </main>
        </div>

        <!-- Data cho biểu đồ -->
        <% if (typeof months !=='undefined' && months) { %>
            <script>
                window.dashboardData = <%- JSON.stringify(months) %>;
            </script>
            <% } else { %>
                <script>
                    window.dashboardData = [];
                </script>
                <% } %>

                    <%- include('../layouts/footer') %>