<% locals.hideFooter=true; extraJS=['/js/admin/order.js'] %>
<%- include('../layouts/header') %>

<style>
/* Modern styling for Orders Redesign v2 */
body { background-color: #F8FAFB; }
.card-board {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

/* KPI Cards */
.kpi-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 16px 20px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
}
.kpi-border-primary { border-left: 4px solid #1677ff; }
.kpi-border-warning { border-left: 4px solid #f59e0b; }
.kpi-border-success { border-left: 4px solid #10b981; }
.kpi-border-info    { border-left: 4px solid #0dcaf0; }

.status-pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    background: transparent;
    color: #495057;
    border: 1px solid #E5E7EB;
}
.status-pill:hover {
    background: #f1f3f5;
}
.status-pill.active {
    background: #2D5F3F;
    color: white;
    border-color: #2D5F3F;
    box-shadow: 0 2px 6px rgba(45, 95, 63, 0.2);
}
.status-pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 8px;
}
.status-pill .count {
    background: #e9ecef;
    color: #6c757d;
    border-radius: 50px;
    padding: 1px 7px;
    font-size: 11px;
    margin-left: 8px;
    font-weight: 600;
}
.status-pill.active .count {
    background: rgba(255,255,255,0.2);
    color: white;
}

/* Exact Hex Dot Colors */
.dot-all { background: #6c757d; }
.dot-pending { background: #92400E; }
.dot-confirmed { background: #166534; }
.dot-shipping { background: #1E40AF; }
.dot-delivered { background: #065F46; }
.dot-cancelled { background: #991B1B; }
.dot-return_requested { background: #9A3412; }
.dot-returned { background: #5B21B6; }
.dot-partially_returned { background: #0284c7; }
.dot-return_rejected { background: #374151; }

.search-bar-modern {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 16px 8px 36px;
    box-shadow: none !important;
    font-size: 14px;
    width: 350px;
}
.search-bar-modern:focus {
    border-color: #2D5F3F;
    outline: none;
}
.search-icon-pos {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #9CA3AF;
}

.floating-action-bar {
    position: fixed;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    background: #2D5F3F;
    color: white;
    padding: 14px 28px;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    gap: 24px;
    transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1000;
}
.floating-action-bar.visible {
    bottom: 30px;
}
.table-checkbox {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: #2D5F3F;
}
.product-thumb {
    width: 32px;
    height: 32px;
    object-fit: cover;
    border-radius: 6px;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
}
.action-btn {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed #adb5bd;
    border-radius: 6px;
    color: #6c757d;
    transition: all 0.2s;
    background: white;
}
.action-btn:hover {
    border-color: #2D5F3F;
    color: #2D5F3F;
    background: #f8f9fa;
}
.badge-minimal {
    padding: 4px 10px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}
.table-borderless th {
    font-weight: 600;
    color: #6B7280;
    font-size: 13px;
    border-bottom: 1px solid #E5E7EB;
    padding-top: 16px;
    padding-bottom: 12px;
}
.order-row:hover {
    background-color: #F0F7F4 !important;
}
.id-copy {
    cursor: pointer;
    color: #9CA3AF;
    transition: color 0.2s;
}
.id-copy:hover { color: #2D5F3F; }

.pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    border-right: 1px solid #E5E7EB;
    padding-right: 12px;
    margin-right: 4px;
}
.pill-group:last-child {
    border-right: none;
}
</style>

<div class="container-fluid py-4" style="max-width: 1400px; margin: 0 auto;">
    
    <!-- KPI Strip -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="kpi-card kpi-border-primary">
                <div class="text-muted small fw-medium mb-1">Tổng đơn hôm nay</div>
                <div class="fs-4 fw-bold text-dark"><%= kpi?.todayCount || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card kpi-border-warning">
                <div class="text-muted small fw-medium mb-1"><i class="far fa-clock text-warning me-1"></i> Chờ xác nhận</div>
                <div class="fs-4 fw-bold text-dark"><%= statusStats['pending'] || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card kpi-border-info">
                <div class="text-muted small fw-medium mb-1"><i class="fas fa-truck text-info me-1"></i> Đang giao</div>
                <div class="fs-4 fw-bold text-dark"><%= statusStats['shipping'] || 0 %></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card kpi-border-success">
                <div class="text-muted small fw-medium mb-1"><i class="fas fa-coins text-success me-1"></i> Doanh thu hôm nay</div>
                <div class="fs-4 fw-bold text-dark"><%= kpi?.todayRevenue ? (kpi.todayRevenue / 1000000).toFixed(1) + 'tr' : '0đ' %></div>
            </div>
        </div>
    </div>

    <!-- Toolbar & Filters -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div class="position-relative">
            <i class="fas fa-search search-icon-pos"></i>
            <input type="text" id="searchInput" class="form-control search-bar-modern" placeholder="Tìm mã đơn, tên khách, email...">
        </div>
        
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 280px; border: 1px solid #E5E7EB; border-radius: 8px; overflow: hidden; background: white;">
                <span class="input-group-text bg-white border-0 text-muted"><i class="far fa-calendar-alt"></i></span>
                <input type="date" id="adminFilterStartDate" class="form-control border-0" value="<%= locals.filterStartDate || '' %>" style="box-shadow: none;">
                <span class="input-group-text bg-white border-0 text-muted px-1">-</span>
                <input type="date" id="adminFilterEndDate" class="form-control border-0" value="<%= locals.filterEndDate || '' %>" style="box-shadow: none;">
            </div>
            <% if (locals.filterStartDate || locals.filterEndDate) { %>
                <button class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" onclick="clearAdminDateFilter()"><i class="fas fa-times"></i></button>
            <% } %>
        </div>
    </div>

    <!-- Status Pills (Grouped logically) -->
    <div class="d-flex flex-wrap gap-2 mb-4 pb-2">
        <% const totalOrdersCount = Object.values(statusStats).reduce((a, b) => a + b, 0); %>
        <div class="pill-group">
            <div class="status-pill <%= currentStatus === 'all' ? 'active' : '' %> filter-btn bg-white" data-status="all">
                Tất cả <span class="count"><%= totalOrdersCount %></span>
            </div>
        </div>
        
        <!-- Đang xử lý -->
        <div class="pill-group">
            <% 
                const processing = [
                    { id: 'pending', name: 'Chờ xác nhận', color: 'pending' },
                    { id: 'confirmed', name: 'Đã xác nhận', color: 'confirmed' },
                    { id: 'shipping', name: 'Đang giao', color: 'shipping' }
                ];
                processing.forEach(st => { 
            %>
                <div class="status-pill <%= currentStatus === st.id ? 'active' : '' %> filter-btn bg-white" data-status="<%= st.id %>">
                    <span class="dot dot-<%= st.color %>"></span> <%= st.name %> <span class="count"><%= statusStats[st.id] || 0 %></span>
                </div>
            <% }) %>
        </div>

        <!-- Hoàn thành -->
        <div class="pill-group">
            <div class="status-pill <%= currentStatus === 'delivered' ? 'active' : '' %> filter-btn bg-white" data-status="delivered">
                <span class="dot dot-delivered"></span> Đã giao <span class="count"><%= statusStats['delivered'] || 0 %></span>
            </div>
        </div>

        <!-- Vấn đề -->
        <div class="pill-group" style="border-right: none;">
            <% 
                const issues = [
                    { id: 'cancelled', name: 'Đã hủy', color: 'cancelled' },
                    { id: 'return_requested', name: 'Y/C Hoàn', color: 'return_requested' },
                    { id: 'returned', name: 'Đã hoàn', color: 'returned' }
                ];
                issues.forEach(st => { 
            %>
                <div class="status-pill <%= currentStatus === st.id ? 'active' : '' %> filter-btn bg-white" data-status="<%= st.id %>">
                    <span class="dot dot-<%= st.color %>"></span> <%= st.name %> <span class="count"><%= statusStats[st.id] || 0 %></span>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Group Orders Data -->
    <% 
        const groups = {};
        orders.forEach(o => {
            const d = new Date(o.createdAt).toLocaleDateString('vi-VN');
            if (!groups[d]) groups[d] = { orders: [], count: 0, revenue: 0 };
            groups[d].orders.push(o);
            groups[d].count++;
            groups[d].revenue += o.total_price;
        });
        
        const badgeColors = {
            pending: { bg: '#FEF3C7', color: '#92400E', dot: '#92400E' },
            confirmed: { bg: '#DCFCE7', color: '#166534', dot: '#166534' },
            shipping: { bg: '#DBEAFE', color: '#1E40AF', dot: '#1E40AF' },
            delivered: { bg: '#D1FAE5', color: '#065F46', dot: '#065F46' },
            cancelled: { bg: '#FEE2E2', color: '#991B1B', dot: '#991B1B' },
            return_requested: { bg: '#FFEDD5', color: '#9A3412', dot: '#9A3412' },
            returned: { bg: '#EDE9FE', color: '#5B21B6', dot: '#5B21B6' },
            partially_returned: { bg: '#e0f2fe', color: '#0284c7', dot: '#0284c7' },
            return_rejected: { bg: '#F3F4F6', color: '#374151', dot: '#374151' }
        };
        const statusLabels = { pending: 'Chờ xác nhận', confirmed: 'Đã xác nhận', shipping: 'Đang giao', delivered: 'Đã giao', cancelled: 'Đã hủy', return_requested: 'Y/C Hoàn hàng', returned: 'Đã hoàn toàn bộ', partially_returned: 'Đã hoàn 1 phần', return_rejected: 'Từ chối hoàn' };
    %>

    <div class="card-board">
        <div class="table-responsive">
            <table class="table table-borderless align-middle mb-0" id="ordersTable">
                <thead>
                    <tr>
                        <th style="width: 40px;" class="ps-4"><input type="checkbox" class="table-checkbox" id="selectAll"></th>
                        <th>#ID đơn</th>
                        <th>Khách hàng</th>
                        <th>Sản phẩm</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-center pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders.length === 0) { %>
                        <tr><td colspan="7" class="text-center py-5 text-muted">Không có đơn hàng nào.</td></tr>
                    <% } else { %>
                        <% Object.keys(groups).forEach(date => { const g = groups[date]; %>
                            <!-- Group Header -->
                            <tr style="background: #F9FAFB; border-top: 1px solid #E5E7EB; border-bottom: 1px solid #E5E7EB;">
                                <td colspan="7" class="py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small fw-bold ps-2" style="color: #92400E;"><i class="far fa-calendar-alt me-2 text-muted"></i>Ngày <%= date %></span>
                                        <span class="small fw-medium text-muted pe-3"><%= g.count %> đơn &bull; <%= g.revenue.toLocaleString('vi-VN') %>đ doanh thu</span>
                                    </div>
                                </td>
                            </tr>
                            <!-- Group Items -->
                            <% g.orders.forEach(order => { %>
                                <tr class="order-row border-bottom" data-status="<%= order.status %>" style="border-color: #E5E7EB !important; background: white;">
                                    <td class="ps-4"><input type="checkbox" class="table-checkbox row-checkbox" value="<%= order._id %>"></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <a href="javascript:void(0)" onclick="viewOrderDetail('<%= order._id %>')" class="text-decoration-none fw-bold font-monospace" style="color: #1E40AF;">
                                                #<%= order._id.toString().slice(-8).toUpperCase() %>
                                            </a>
                                            <i class="far fa-copy id-copy" onclick="navigator.clipboard.writeText('<%= order._id %>'); showToast('Đã copy mã đơn', 'info');" title="Copy ID"></i>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark" style="font-size: 14px; font-family: 'Poppins', sans-serif;"><%= order.user_id?.name || 'Khách vãng lai' %></div>
                                        <div class="text-muted" style="font-size: 13px;"><%= order.user_id?.email || '' %></div>
                                        <div class="text-muted d-flex align-items-center mt-1" style="font-size: 12px; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= order.address %>">
                                            <i class="fas fa-map-marker-alt text-gray-400 me-1"></i> <%= order.address %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <% if(order.items && order.items.length > 0) { %>
                                                <% const firstItem = order.items[0]; %>
                                                <img src="/images/products/<%= firstItem.product_id?.image || 'default.png' %>" class="product-thumb shadow-sm">
                                                <div>
                                                    <div class="fw-medium text-dark" style="font-size: 14px;"><%= firstItem.name %></div>
                                                    <div class="text-muted" style="font-size: 12px;">
                                                        <% if(order.items.length === 1) { %>
                                                            <%= firstItem.quantity %> sản phẩm
                                                        <% } else { %>
                                                            +<%= order.items.length - 1 %> sản phẩm khác
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="fw-bold text-dark" style="font-size: 14px;"><%= parseInt(order.total_price).toLocaleString('vi-VN') %>đ</td>
                                    <td>
                                        <% const bc = badgeColors[order.status] || badgeColors.pending; %>
                                        <div class="badge-minimal" style="background: <%= bc.bg %>; color: <%= bc.color %>;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: <%= bc.dot %>;"></span>
                                            <%= statusLabels[order.status] %>
                                        </div>
                                    </td>
                                    <td class="text-center pe-4">
                                        <% if (['return_requested', 'returned', 'partially_returned', 'return_rejected'].includes(order.status)) { %>
                                            <button class="action-btn" onclick="viewReturnRequest('<%= order._id %>')" title="Xem Y/C Hoàn">
                                                <i class="fas fa-eye" style="font-size: 14px;"></i>
                                            </button>
                                        <% } else if (order.status === 'cancelled') { %>
                                            <i class="fas fa-lock text-muted" title="Không thể cập nhật"></i>
                                        <% } else { %>
                                            <div class="dropdown d-inline-block">
                                                <button class="action-btn" data-bs-toggle="dropdown" title="Hành động">
                                                    <i class="fas fa-chevron-down" style="font-size: 12px;"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="font-size: 14px;">
                                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="viewOrderDetail('<%= order._id %>')"><i class="fas fa-eye text-muted me-2"></i> Xem chi tiết</a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><h6 class="dropdown-header">Cập nhật nhanh</h6></li>
                                                    <% const flow = ['pending', 'confirmed', 'shipping', 'delivered']; const cIdx = flow.indexOf(order.status); %>
                                                    <% flow.forEach((st, idx) => { if(idx > cIdx) { %>
                                                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="window.updateStatusFast('<%= order._id %>', '<%= st %>')"><%= statusLabels[st] %></a></li>
                                                    <% }}); %>
                                                    <% if (order.status === 'pending' || order.status === 'confirmed') { %>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="window.updateStatusFast('<%= order._id %>', 'cancelled')"><i class="fas fa-ban me-2"></i> Hủy đơn</a></li>
                                                    <% } %>
                                                </ul>
                                            </div>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Floating Action Bar -->
<div class="floating-action-bar" id="floatingBar">
    <div class="fw-medium">Đã chọn <span id="selectedCount" class="fw-bold fs-5 mx-1">0</span> đơn</div>
    <div class="d-flex gap-2 border-start ps-4 border-light border-opacity-25">
        <button class="btn btn-sm btn-outline-light"><i class="fas fa-file-excel me-1"></i> Xuất Excel</button>
        <button class="btn btn-sm btn-light text-success fw-medium"><i class="fas fa-edit me-1"></i> Cập nhật hàng loạt</button>
        <button class="btn btn-sm btn-link text-white text-decoration-none" onclick="document.getElementById('selectAll').click()">Bỏ chọn</button>
    </div>
</div>

<!-- Return Request Admin Modal -->
<div class="modal fade" id="adminReturnModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Chi tiết yêu cầu hoàn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="adminReturnContent">
                <div class="text-center py-4"><span class="spinner-border text-success"></span></div>
            </div>
            <div class="modal-footer border-top-0 pt-0" id="adminReturnFooter"></div>
        </div>
    </div>
</div>

<!-- Order Detail Modal -->
<div class="modal fade" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header text-white" style="background-color: #2D5F3F; border-bottom: none;">
                <h5 class="modal-title fw-medium"><i class="fas fa-file-invoice me-2"></i>Chi tiết đơn hàng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="orderDetailContent" style="background-color: #F8FAFB;">
                <div class="text-center py-4"><span class="spinner-border text-success"></span></div>
            </div>
            <div class="modal-footer border-top-0 bg-white">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>