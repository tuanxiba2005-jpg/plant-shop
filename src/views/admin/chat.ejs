<%- include('../layouts/header') %>

<link rel="stylesheet" href="/css/admin-chat.css">
<input type="hidden" id="adminIdData" value="<%= user._id %>">

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 text-success fw-bold"><i class="fas fa-headset me-2"></i>Hỗ trợ trực tuyến</h4>
    </div>

    <div class="chat-container">
        <!-- Sidebar danh sách khách hàng -->
        <div class="chat-sidebar">
            <div class="p-3 border-bottom bg-light">
                <h6 class="m-0 fw-bold">Khách hàng cần hỗ trợ</h6>
            </div>
            <div class="chat-list" id="customer-list">
                <% if (chatList && chatList.length > 0) { %>
                    <% chatList.forEach(chat => { %>
                        <div class="chat-item d-flex align-items-center" data-room="<%= chat._id %>" onclick="openChat('<%= chat._id %>', '<%= chat.user.name %>')">
                            <div class="position-relative">
                                <img src="<%= chat.user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(chat.user.name) + '&background=e2e8e4&color=2d5f3f' %>" class="rounded-circle border" width="48" height="48" style="object-fit:cover;">
                                <% if (chat.unreadCount > 0) { %>
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="width: 12px; height: 12px;" id="badge-<%= chat._id %>">
                                        <span class="visually-hidden">New alerts</span>
                                    </span>
                                <% } else { %>
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle d-none" style="width: 12px; height: 12px;" id="badge-<%= chat._id %>">
                                    </span>
                                <% } %>
                            </div>
                            <div class="ms-3 flex-fill overflow-hidden">
                                <h6 class="mb-1 text-truncate"><%= chat.user.name %></h6>
                                <p class="mb-0 text-muted small text-truncate" id="lastmsg-<%= chat._id %>"><%= chat.lastMessage.content %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-4 text-center text-muted">Chưa có cuộc trò chuyện nào</div>
                <% } %>
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="chat-main">
            <div class="p-3 border-bottom bg-light d-flex align-items-center" id="chat-header" style="display: none !important;">
                <h6 class="m-0 fw-bold" id="current-chat-name">Đang tải...</h6>
            </div>
            
            <div id="no-chat-selected" class="flex-fill d-flex align-items-center justify-content-center text-muted flex-column">
                <i class="fas fa-comments fs-1 mb-3 text-success opacity-50"></i>
                <p>Chọn một khách hàng để bắt đầu trò chuyện</p>
            </div>

            <div class="chat-messages d-none d-flex flex-column" id="chat-messages">
                <!-- Tin nhắn hiển thị ở đây -->
            </div>

            <div class="chat-input-area d-none" id="chat-input-area">
                <form id="admin-chat-form" class="d-flex gap-2">
                    <input type="text" id="admin-chat-input" class="form-control" placeholder="Nhập câu trả lời..." required autocomplete="off">
                    <button type="submit" class="btn btn-success px-4"><i class="fas fa-paper-plane"></i></button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/admin/chat.js"></script>

<%- include('../layouts/footer') %>
