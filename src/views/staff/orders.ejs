<% 
    locals.hideFooter = true; 
    extraJS=['/js/staff/orders.js'] 
%>
<%- include('../layouts/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">📦 Quản lý đơn hàng</h4>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="mb-3 d-flex gap-2 flex-wrap">
            <a href="?status=all" class="btn btn-outline-secondary btn-sm <%= currentStatus === 'all' ? 'active' : '' %>">Tất cả</a>
            <a href="?status=pending" class="btn btn-outline-warning btn-sm <%= currentStatus === 'pending' ? 'active' : '' %>">Chờ xác nhận</a>
            <a href="?status=confirmed" class="btn btn-outline-info btn-sm <%= currentStatus === 'confirmed' ? 'active' : '' %>">Đã xác nhận</a>
            <a href="?status=shipping" class="btn btn-outline-primary btn-sm <%= currentStatus === 'shipping' ? 'active' : '' %>">Đang giao</a>
            <a href="?status=delivered" class="btn btn-outline-success btn-sm <%= currentStatus === 'delivered' ? 'active' : '' %>">Đã giao</a>
            <a href="?status=cancelled" class="btn btn-outline-danger btn-sm <%= currentStatus === 'cancelled' ? 'active' : '' %>">Đã hủy</a>
            <a href="?status=return_requested" class="btn btn-outline-warning btn-sm fw-bold border-2 <%= currentStatus === 'return_requested' ? 'active' : '' %>">Y/C Hoàn hàng</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-success">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày đặt</th>
                        <th>Cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    <% const badges={ pending: 'warning', confirmed: 'info', shipping: 'primary', delivered: 'success', cancelled: 'danger', return_requested: 'warning', returned: 'secondary', return_rejected: 'dark' } %>
                    <% const labels={ pending: 'Chờ xác nhận' , confirmed: 'Đã xác nhận' ,
                        shipping: 'Đang giao' , delivered: 'Đã giao' , cancelled: 'Đã hủy', return_requested: 'Y/C Hoàn hàng', returned: 'Đã hoàn hàng', return_rejected: 'Từ chối hoàn' } %>
                    <% orders.forEach(order => { %>
                    <tr>
                        <td><small class="text-muted">#<%= order._id.toString().slice(-6).toUpperCase() %></small></td>
                        <td><%= order.user_id?.name || 'Khách' %></td>
                        <td class="text-success fw-bold">
                            <%= parseInt(order.total_price).toLocaleString('vi-VN') %>đ
                        </td>
                        <td>
                            <span class="badge bg-<%= badges[order.status] %>"><%= labels[order.status] %></span>
                        </td>
                        <td><%= new Date(order.createdAt).toLocaleDateString('vi-VN') %></td>
                        <td>
                            <% if (['return_requested', 'returned', 'return_rejected'].includes(order.status)) { %>
                                <button class="btn btn-sm btn-outline-danger" onclick="viewReturnRequest('<%= order._id %>')">Xem Y/C Hoàn</button>
                            <% } else if (order.status === 'cancelled') { %>
                                <span class="text-muted">Không thể cập nhật</span>
                            <% } else { %>
                            <% 
                                const flow = ['pending', 'confirmed', 'shipping', 'delivered'];
                                const currentIndex = flow.indexOf(order.status);
                            %>
                            <select class="form-select form-select-sm status-select"
                                    data-id="<%= order._id %>"
                                    style="width: 130px;">
                                <% flow.forEach((st, idx) => { %>
                                    <option value="<%= st %>" <%= order.status === st ? 'selected' : '' %> <%= idx < currentIndex ? 'disabled' : '' %>><%= labels[st] %></option>
                                <% }) %>
                                <% if (order.status === 'pending' || order.status === 'confirmed') { %>
                                    <option value="cancelled">Đã hủy</option>
                                <% } %>
                            </select>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Return Request Modal -->
<div class="modal fade" id="adminReturnModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết yêu cầu hoàn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="adminReturnContent">
                <div class="text-center py-4"><span class="spinner-border text-success"></span></div>
            </div>
            <div class="modal-footer" id="adminReturnFooter"></div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>