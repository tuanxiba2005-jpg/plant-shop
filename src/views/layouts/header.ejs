<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | 🌿 Tuan's Green
    </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <% if (typeof extraCSS !=='undefined' ) { %>
        <% extraCSS.forEach(href => { %>
            <link rel="stylesheet" href="<%= href %>">
        <% }) %>
    <% } %>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
                <img src="/images/logo.png" alt="Tuan's Green" style="height: 65px; width: auto; object-fit: contain;">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">

                <!-- Menu trái -->
                <ul class="navbar-nav me-3">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Cây cảnh</a>
                    </li>

                    <!-- Dropdown danh mục -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            🌱 Danh mục
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="/products">Tất cả</a>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <% globalCategories.forEach(cat=> { %>
                                <li>
                                    <a class="dropdown-item" href="/products?category=<%= cat._id %>">
                                        <%= cat.name %>
                                    </a>
                                </li>
                                <% }) %>
                        </ul>
                    </li>
                </ul>

                <!-- Thanh tìm kiếm ở giữa -->
                <form action="/products" method="GET" class="d-flex me-auto" style="width: 280px;">
                    <input type="text" name="search" class="form-control form-control-sm"
                        placeholder="🔍 Tìm cây cảnh..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>">
                    <button class="btn btn-success btn-sm ms-1" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </form>

                <!-- Menu phải -->
                <ul class="navbar-nav">
                    <% if (user) { %>
                        <!-- Notification Bell -->
                        <li class="nav-item dropdown me-2">
                            <a class="nav-link position-relative" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" onclick="markNotificationsAsRead()">
                                <i class="fas fa-bell fs-5 text-muted hover-text-success"></i>
                                <span id="notificationBadge" class="position-absolute top-10 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.65rem; padding: 0.25em 0.4em;">
                                    0
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm p-0" aria-labelledby="notificationDropdown" id="notificationList" style="width: 350px; max-height: 400px; overflow-y: auto; border-radius: 12px; border: none;">
                                <li><div class="dropdown-item text-center text-muted small py-4"><i class="fas fa-spinner fa-spin me-2"></i> Đang tải thông báo...</div></li>
                            </ul>
                        </li>
                        <% if (user.role==='admin' ) { %>
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="/admin/chat">
                                    <i class="fas fa-headset me-1 text-success"></i>Hỗ trợ
                                    <span id="header-chat-badge-admin" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="display: none;"></span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin/dashboard">
                                    <i class="fas fa-cog me-1"></i>Quản trị
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-shield me-1"></i>
                                    <%= user.name %>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <span class="dropdown-item-text text-muted small">
                                            <%= user.email %>
                                        </span>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin/dashboard">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin/products">
                                            <i class="fas fa-leaf me-2"></i>Quản lý sản phẩm
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin/orders">
                                            <i class="fas fa-boxes me-2"></i>Quản lý đơn hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin/users">
                                            <i class="fas fa-users me-2"></i>Quản lý người dùng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin/revenue">
                                            <i class="fas fa-chart-bar me-2"></i>Báo cáo doanh thu
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin/coupons">
                                            <i class="fas fa-tags me-2"></i>Mã giảm giá
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin/chat">
                                            <i class="fas fa-headset me-2"></i>Hỗ trợ khách hàng
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="/user/logout">
                                            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <% } else if (user.role==='staff' ) { %>
                                <li class="nav-item">
                                    <a class="nav-link position-relative" href="/admin/chat">
                                        <i class="fas fa-headset me-1 text-success"></i>Hỗ trợ
                                        <span id="header-chat-badge-staff" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="display: none;"></span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/staff/dashboard">
                                        <i class="fas fa-clipboard-list me-1"></i>Nhân viên
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                        <i class="fas fa-user-tie me-1"></i>
                                        <%= user.name %>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <span class="dropdown-item-text text-muted small">
                                                <%= user.email %>
                                            </span>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/staff/dashboard">
                                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/staff/products">
                                                <i class="fas fa-leaf me-2"></i>Quản lý sản phẩm
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/staff/orders">
                                                <i class="fas fa-boxes me-2"></i>Quản lý đơn hàng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/staff/customers">
                                                <i class="fas fa-users me-2"></i>Danh sách khách hàng
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger" href="/user/logout">
                                                <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <% } else { %>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/cart">
                                            <i class="fas fa-shopping-cart"></i>
                                            <span class="badge bg-danger" id="cartBadge">
                                                <%= cartCount %>
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                            <i class="fas fa-user me-1"></i>
                                            <%= user.name %>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <span class="dropdown-item-text text-muted small">
                                                    <%= user.email %>
                                                </span>
                                            </li>
                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="/user/profile">
                                                    <i class="fas fa-user me-2"></i>Tài khoản
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="/orders/my-orders">
                                                    <i class="fas fa-box me-2"></i>Đơn hàng của tôi
                                                </a>
                                            </li>
                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="/user/logout">
                                                    <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                    <% } %>
                                        <% } else { %>
                                            <li class="nav-item">
                                                <a class="nav-link" href="/user/login">
                                                    <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
                                                </a>
                                            </li>
                                            <li class="nav-item ms-2">
                                                <a class="nav-link btn btn-success text-white px-3"
                                                    href="/user/register">
                                                    Đăng ký
                                                </a>
                                            </li>
                                            <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">