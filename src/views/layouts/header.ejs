<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | 🌿 Tuan's Green
    </title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Plant Shop - Cửa hàng bán cây cảnh trực tuyến uy tín, chất lượng với đa dạng các loại cây cảnh trong nhà, ngoài trời, cây phong thủy và phụ kiện.' %>">
    <meta name="keywords" content="cây cảnh, cây phong thủy, cây trong nhà, mua cây cảnh, plant shop">
    
    <!-- Open Graph for Social Media Sharing -->
    <meta property="og:title" content="<%= title %> | 🌿 Tuan's Green">
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Khám phá bộ sưu tập cây cảnh tuyệt đẹp tại Plant Shop. Mang thiên nhiên vào không gian sống của bạn.' %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/images/logo.png' %>">
    <meta property="og:type" content="website">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <% if (typeof extraCSS !=='undefined' ) { %>
        <% extraCSS.forEach(href => { %>
            <link rel="stylesheet" href="<%= href %>">
        <% }) %>
    <% } %>

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2d5f3f">
    <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('SW registered: ', registration);
                    })
                    .catch(registrationError => {
                        console.log('SW registration failed: ', registrationError);
                    });
            });
        }
    </script>
</head>

<body>
    <!-- Tier 1: Top Bar -->
    <div class="border-bottom d-none d-lg-block position-relative z-3 top-bar-custom">
        <div class="container d-flex justify-content-end py-2 align-items-center">
            <ul class="nav text-muted">
                <% if (user && (user.role === 'admin' || user.role === 'staff')) { %>
                    <li class="nav-item border-end px-3">
                        <a class="nav-link text-muted p-0 hover-success position-relative" href="<%= user.role === 'admin' ? '/admin/chat' : '/staff/chat' %>">
                            <i class="fas fa-headset me-1"></i>Hỗ trợ
                            <span id="header-chat-badge-<%= user.role %>" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="display: none;"></span>
                        </a>
                    </li>
                <% } else if (user) { %>
                    <li class="nav-item border-end px-3">
                        <a class="nav-link text-muted p-0 hover-success" href="/support">
                            <i class="fas fa-headset me-1"></i>Hỗ trợ
                        </a>
                    </li>
                <% } else { %>
                    <li class="nav-item border-end px-3">
                        <a class="nav-link text-muted p-0 hover-success" href="#" onclick="Swal.fire({icon: 'info', title: 'Yêu cầu đăng nhập', text: 'Vui lòng đăng nhập để chat với nhân viên hỗ trợ!', showCancelButton: true, confirmButtonText: 'Đăng nhập ngay', cancelButtonText: 'Để sau', confirmButtonColor: '#2d5f3f'}).then((result) => { if(result.isConfirmed) window.location.href='/user/login'; }); return false;">
                            <i class="fas fa-headset me-1"></i>Hỗ trợ
                        </a>
                    </li>
                <% } %>
                <li class="nav-item px-3 border-end">
                    <a class="nav-link text-muted p-0 hover-success" href="https://maps.google.com/?q=123+Hoàng+Hoa+Thám,+Ba+Đình,+Hà+Nội" target="_blank" title="Xem trên Google Maps">
                        <i class="fas fa-map-marker-alt me-1 text-danger"></i>Cửa hàng
                    </a>
                </li>
                <% if (user) { %>
                    <% if (user.role === 'admin') { %>
                        <li class="nav-item ps-3 ms-2 border-start d-flex align-items-center">
                            <div class="d-flex align-items-center bg-white rounded-pill px-3 py-1 shadow-sm border border-success-subtle">
                                <a href="/admin/dashboard" class="text-success text-decoration-none fw-medium me-2 header-user-role">
                                    <i class="fas fa-cog"></i> Quản trị
                                </a>
                                <span class="text-muted opacity-25 mx-1">|</span>
                                <div class="dropdown ms-2">
                                    <a class="text-dark text-decoration-none fw-medium dropdown-toggle header-user-role" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                                        <% if (user && user.avatar) { %>
                                            <img src="<%= user.avatar %>" alt="Avatar" class="rounded-circle me-1" style="width: 20px; height: 20px; object-fit: cover;">
                                        <% } else { %>
                                            <i class="far fa-user-circle me-1 text-success"></i>
                                        <% } %>
                                        <%= user.name %>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm dropdown-menu-modern header-dropdown-menu-modern">
                                        <li>
                                            <div class="px-3 py-2 border-bottom mb-1 bg-light rounded-top">
                                                <span class="d-block fw-bold text-dark"><%= user.name %></span>
                                                <small class="text-muted"><%= user.email %></small>
                                            </div>
                                        </li>
                                        <li><a class="dropdown-item" href="/user/profile"><i class="fas fa-user-edit me-2 text-muted"></i>Hồ sơ cá nhân</a></li>
                                        <li><a class="dropdown-item" href="/admin/dashboard"><i class="fas fa-tachometer-alt me-2 text-muted"></i>Dashboard</a></li>
                                        <li><a class="dropdown-item" href="/admin/products"><i class="fas fa-leaf me-2 text-muted"></i>Quản lý sản phẩm</a></li>
                                        <li><a class="dropdown-item" href="/admin/categories"><i class="fas fa-folder me-2 text-muted"></i>Quản lý danh mục</a></li>
                                        <li><a class="dropdown-item" href="/admin/articles"><i class="fas fa-newspaper me-2 text-muted"></i>Quản lý bài viết</a></li>
                                        <li><a class="dropdown-item" href="/admin/orders"><i class="fas fa-boxes me-2 text-muted"></i>Quản lý đơn hàng</a></li>
                                        <li><a class="dropdown-item" href="/admin/users"><i class="fas fa-users me-2 text-muted"></i>Quản lý người dùng</a></li>
                                        <li><a class="dropdown-item" href="/admin/revenue"><i class="fas fa-chart-bar me-2 text-muted"></i>Báo cáo doanh thu</a></li>
                                        <li><a class="dropdown-item" href="/admin/discounts"><i class="fas fa-percent me-2 text-muted"></i>Khuyến mãi SP</a></li>
                                        <li><a class="dropdown-item" href="/admin/coupons"><i class="fas fa-tags me-2 text-muted"></i>Mã giảm giá</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="/user/logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    <% } else if (user.role === 'staff') { %>
                        <li class="nav-item ps-3 ms-2 border-start d-flex align-items-center">
                            <div class="d-flex align-items-center bg-white rounded-pill px-3 py-1 shadow-sm border border-success-subtle">
                                <a href="/staff/dashboard" class="text-success text-decoration-none fw-medium me-2 header-user-role">
                                    <i class="fas fa-cog"></i> Quản trị
                                </a>
                                <span class="text-muted opacity-25 mx-1">|</span>
                                <div class="dropdown ms-2">
                                    <a class="text-dark text-decoration-none fw-medium dropdown-toggle header-user-role" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                                        <% if (user && user.avatar) { %>
                                            <img src="<%= user.avatar %>" alt="Avatar" class="rounded-circle me-1" style="width: 20px; height: 20px; object-fit: cover;">
                                        <% } else { %>
                                            <i class="far fa-user-circle me-1 text-success"></i>
                                        <% } %>
                                        <%= user.name %>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm dropdown-menu-modern header-dropdown-menu-modern">
                                        <li>
                                            <div class="px-3 py-2 border-bottom mb-1 bg-light rounded-top">
                                                <span class="d-block fw-bold text-dark"><%= user.name %></span>
                                                <small class="text-muted"><%= user.email %></small>
                                            </div>
                                        </li>
                                        <li><a class="dropdown-item" href="/user/profile"><i class="fas fa-user-edit me-2 text-muted"></i>Hồ sơ cá nhân</a></li>
                                        <li><a class="dropdown-item" href="/staff/dashboard"><i class="fas fa-tachometer-alt me-2 text-muted"></i>Dashboard</a></li>
                                        <li><a class="dropdown-item" href="/staff/products"><i class="fas fa-leaf me-2 text-muted"></i>Quản lý sản phẩm</a></li>
                                        <li><a class="dropdown-item" href="/staff/orders"><i class="fas fa-boxes me-2 text-muted"></i>Quản lý đơn hàng</a></li>
                                        <li><a class="dropdown-item" href="/staff/customers"><i class="fas fa-users me-2 text-muted"></i>Danh sách khách hàng</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="/user/logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    <% } else { %>
                        <li class="nav-item px-3 dropdown">
                            <a class="nav-link text-muted p-0 fw-medium dropdown-toggle hover-success" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                                <% if (user && user.avatar) { %>
                                    <img src="<%= user.avatar %>" alt="Avatar" class="rounded-circle me-1" style="width: 20px; height: 20px; object-fit: cover;">
                                <% } else { %>
                                    <i class="fas fa-user me-1 text-success"></i>
                                <% } %>
                                <%= user.name %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm dropdown-menu-modern header-dropdown-menu-sm">
                                <li>
                                    <div class="px-3 py-2 border-bottom mb-1 bg-light rounded-top">
                                        <span class="d-block fw-bold text-dark"><%= user.name %></span>
                                        <small class="text-muted"><%= user.email %></small>
                                    </div>
                                </li>
                                <li><a class="dropdown-item" href="/user/profile"><i class="fas fa-user-edit me-2 text-muted"></i>Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item" href="/orders/my-orders"><i class="fas fa-box-open me-2 text-muted"></i>Đơn hàng của tôi</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/user/logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </li>
                    <% } %>
                <% } else { %>
                    <li class="nav-item px-3 dropdown">
                        <a class="nav-link text-muted p-0 dropdown-toggle hover-success" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                            <i class="fas fa-user-circle me-1"></i>Khách
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm header-dropdown-menu-sm">
                            <li><a class="dropdown-item fw-medium text-success" href="/user/login"><i class="fas fa-sign-in-alt me-2"></i>Đăng nhập</a></li>
                            <li><a class="dropdown-item" href="/user/register"><i class="fas fa-user-plus me-2 text-muted"></i>Tạo tài khoản</a></li>
                        </ul>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>

    <!-- Sticky Header Wrapper -->
    <header class="sticky-top shadow-sm header-sticky-wrapper">
        <!-- Tier 2: Main Bar -->
        <div class="bg-white py-3 border-bottom position-relative z-2">
        <div class="container d-flex align-items-center justify-content-between flex-wrap">
            <!-- Logo -->
            <a class="navbar-brand fw-bold d-flex align-items-center m-0 order-1" href="/">
                <img src="/images/logo.png" alt="Tuan's Green" class="header-logo">
            </a>

            <!-- Search Bar -->
            <div class="flex-grow-1 order-3 order-lg-2 mt-3 mt-lg-0 w-100 mx-lg-4 search-container-custom">
                <form action="/products" method="GET">
                    <div class="d-flex align-items-center rounded-pill px-2 py-1 border border-success-subtle search-wrapper-pill">
                        <i class="fas fa-search text-success ms-3 me-2"></i>
                        <input type="text" name="search" class="form-control border-0 px-3 py-2 rounded-pill shadow-sm search-input-pill"
                            placeholder="Tìm cây cảnh, kinh nghiệm..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>">
                        <button type="submit" class="btn btn-success rounded-pill px-4 ms-2 me-1 fw-medium header-search-btn">
                            Tìm
                        </button>
                    </div>
                </form>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-2 gap-md-3 order-2 order-lg-3">
                <!-- Notifications -->
                <% if (user) { %>
                    <div class="dropdown">
                        <button class="btn btn-action btn-action-modern rounded-4 border p-2 d-flex align-items-center justify-content-center action-btn-custom" type="button" id="notificationDropdown" data-bs-toggle="dropdown" onclick="markNotificationsAsRead()">
                            <i class="far fa-bell text-dark fs-5"></i>
                            <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="display: none;">
                                <span class="visually-hidden">New alerts</span>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm dropdown-menu-modern p-0" aria-labelledby="notificationDropdown" id="notificationList" class="header-notification-menu">
                            <li><h6 class="dropdown-header fw-bold text-dark border-bottom py-3 bg-light rounded-top">Thông báo mới</h6></li>
                            <li><div class="dropdown-item text-center text-muted small py-4"><i class="fas fa-spinner fa-spin me-2"></i> Đang tải thông báo...</div></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a href="/user/login" class="btn btn-action btn-action-modern rounded-4 border p-2 d-flex align-items-center justify-content-center action-btn-custom">
                        <i class="far fa-bell text-dark fs-5"></i>
                    </a>
                <% } %>

                <% if (!user || (user.role !== 'admin' && user.role !== 'staff')) { %>
                    <!-- Cart -->
                    <a href="/cart" class="btn btn-action btn-action-modern rounded-4 border position-relative p-2 d-flex align-items-center justify-content-center action-btn-custom text-decoration-none">
                        <i class="fas fa-shopping-bag text-dark"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm" id="cartBadge">
                            <%= typeof cartCount !== 'undefined' ? cartCount : 0 %>
                        </span>
                    </a>

                    <!-- User Profile -->
                    <a href="<%= user ? '/user/profile' : '/user/login' %>" class="btn btn-action btn-action-modern rounded-4 border p-2 d-flex align-items-center justify-content-center action-btn-custom text-decoration-none">
                        <% if (typeof user !== 'undefined' && user && user.avatar) { %>
                            <img src="<%= user.avatar %>" alt="Avatar" class="rounded-circle" style="width: 28px; height: 28px; object-fit: cover;">
                        <% } else { %>
                            <i class="far fa-user-circle text-dark fs-5"></i>
                        <% } %>
                    </a>
                <% } %>

                <!-- Dashboard Button for Admin/Staff -->
                <% if (user && (user.role === 'admin' || user.role === 'staff')) { %>
                    <a href="/<%= user.role %>/dashboard" class="btn btn-action btn-action-modern rounded-4 border px-3 d-flex align-items-center justify-content-center gap-2 text-decoration-none" class="header-dashboard-btn">
                        <i class="fas fa-th-large text-dark"></i>
                        <span class="fw-medium text-dark d-none d-sm-inline">Dashboard</span>
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Tier 3: Nav Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark p-0 position-relative z-1 nav-tier-3">
        <div class="container">
            <button class="navbar-toggler my-2 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto fw-medium">
                    <li class="nav-item">
                        <a class="nav-link nav-link-animated text-white py-3 px-3 <%= typeof title !== 'undefined' && title === 'Trang chủ' ? 'fw-bold active' : '' %>" href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-animated text-white-50 py-3 px-3 hover-text-white" href="/products">Cây cảnh</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-animated text-white-50 py-3 px-3 hover-text-white" href="/plant-care">Bí quyết chăm sóc</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-animated text-white-50 py-3 px-3 hover-text-white" href="/blogs">Góc chia sẻ</a>
                    </li>
                    
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white-50 py-3 px-3 hover-text-white d-flex align-items-center gap-1" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-leaf" class="header-cat-icon"></i> Danh mục
                        </a>
                        <ul class="dropdown-menu dropdown-menu-modern shadow-sm mt-0" class="header-cat-dropdown">
                            <li><a class="dropdown-item py-2" href="/products">Tất cả sản phẩm</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <% if (typeof globalCategories !== 'undefined') { %>
                                <% globalCategories.forEach(cat => { %>
                                    <li><a class="dropdown-item py-2" href="/products?category=<%= cat._id %>"><%= cat.name %></a></li>
                                <% }) %>
                            <% } %>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    </header>

    <main class="container my-4">