<% extraJS = ['/js/login.js'] %>
<% locals.hideFooter = true; %>
<%- include('../layouts/header') %>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0">🌿 Đăng nhập</h4>
            </div>
            <div class="card-body p-4">
                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <% if (typeof query !== 'undefined' && query.success) { %>
                <div class="alert alert-success"><%= query.success %></div>
                <% } else if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success"><%= success %></div>
                <% } %>

                <form action="/user/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" name="email" class="form-control"
                               placeholder="example@email.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <div class="input-group">
                            <input type="password" name="password" id="password"
                                   class="form-control" placeholder="••••••••" required>
                            <button class="btn btn-outline-secondary" type="button"
                                    id="togglePassword">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>
                    <!-- Link quên mật khẩu -->
                    <div class="text-end mb-3">
                        <a href="/user/forgot-password" class="text-success small">Quên mật khẩu?</a>
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                        Đăng nhập
                    </button>
                </form>

                <hr>
                <p class="text-center mb-0">
                    Chưa có tài khoản?
                    <a href="/user/register" class="text-success fw-bold">Đăng ký ngay</a>
                </p>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
