<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | 🌿 Plant Shop
    </title>
    <!-- Use Bootstrap and Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS for Profile Dashboard -->
    <link rel="stylesheet" href="/css/profile.css">
</head>

<body>

    <div class="dashboard-container">

        <!-- ==================== SIDEBAR ==================== -->
        <aside class="dash-sidebar">
            <a href="/" class="brand-logo" style="text-decoration:none;">
                <i class="fas fa-seedling"></i>
                <span>Home</span>
            </a>

            <ul class="sidebar-menu">
                <li>
                    <a href="#" class="active" data-target="dashboard">
                        <i class="fas fa-headset"></i>
                        <span>Trang tổng quan</span>
                    </a>
                </li>
                <li>
                    <a href="#" data-target="profile">
                        <i class="far fa-user"></i>
                        <span>Hồ sơ cá nhân</span>
                    </a>
                </li>
                <li>
                    <a href="/orders/my-orders">
                        <i class="fas fa-box-open"></i>
                        <span>Đơn hàng của tôi</span>
                    </a>
                </li>
                <li>
                    <a href="#" data-target="payment">
                        <i class="far fa-credit-card"></i>
                        <span>Thanh toán</span>
                    </a>
                </li>
                <li>
                    <a href="#" data-target="address">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Sổ địa chỉ</span>
                    </a>
                </li>
                <li>
                    <a href="#" data-target="wishlist"
                        style="display:flex; justify-content:space-between; align-items:center;">
                        <div style="display:flex; align-items:center;">
                            <i class="far fa-heart"></i>
                            <span>Yêu thích</span>
                        </div>
                    </a>
                </li>
            </ul>

            <div style="margin-top: auto;">
                <ul class="sidebar-menu">
                    <li>
                        <a href="/user/logout" style="color:#d32f2f;">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Đăng xuất</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- ==================== MAIN CONTENT ==================== -->
        <main class="dash-main">

            <!-- Header -->
            <header class="main-header">
                <div class="search-bar">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Tìm kiếm mã đơn hoặc tên cây...">
                </div>

                <div class="header-actions">
                    <button class="dropdown-btn">Gói: Premium <i class="fas fa-chevron-down ms-1"
                            style="font-size:12px"></i></button>
                    <% if (userInfo.avatar) { %>
                        <img src="<%= userInfo.avatar %>" alt="Avatar" class="avatar-small rounded-circle" style="width:40px; height:40px; object-fit:cover; border:2px solid #2E7D32;">
                    <% } else { %>
                        <div class="avatar-small" style="background-color: #e2e8e4; color: #2d5f3f; border:2px solid #2E7D32;">
                            <%= userInfo.name.charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                </div>
            </header>

            <!-- Thông báo chung -->
            <% if (locals.success) { %>
                <div class="alert alert-success d-flex align-items-center gap-2 mb-4 shadow-sm"
                    style="border-radius: 12px; border: none;">
                    <i class="fas fa-check-circle fs-5"></i>
                    <%= success %>
                </div>
                <% } %>
                    <% if (locals.error) { %>
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 shadow-sm"
                            style="border-radius: 12px; border: none;">
                            <i class="fas fa-exclamation-circle fs-5"></i>
                            <%= error %>
                        </div>
                        <% } %>

                            <!-- TAB: DASHBOARD -->
                            <div id="dashboard" class="tab-pane" style="display: block;">
                                <!-- Profile Card Top -->
                                <section class="profile-card-top">
                                    <div class="dash-card"
                                        style="flex:1; display:flex; flex-direction:column; align-items:center; text-align:center; position:relative;">
                                        <% if (userInfo.avatar) { %>
                                            <img src="<%= userInfo.avatar %>" alt="Avatar" class="avatar-large rounded-circle" style="margin-bottom:16px; width:80px; height:80px; object-fit:cover; border:3px solid #2E7D32;">
                                        <% } else { %>
                                            <div class="avatar-large" style="margin-bottom:16px; background-color: #e2e8e4; color: #2d5f3f; border:3px solid #2E7D32;">
                                                <%= userInfo.name.charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                        <h2 style="margin:0 0 4px 0; font-size:18px;">
                                            <%= userInfo.name %>
                                        </h2>
                                        <p style="margin:0 0 12px 0; font-size:12px; color:#757575;">Khách hàng thân
                                            thiết</p>
                                        <div class="stars" style="margin-bottom:16px;">
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star-half-alt"></i>
                                        </div>
                                    </div>

                                    <div style="flex:2; display:flex; gap:16px;">
                                        <div class="dash-card"
                                            style="flex:1; text-align:center; position:relative; padding:24px 16px;">
                                            <i class="fas fa-times"
                                                style="position:absolute; top:12px; right:12px; color:#bdbdbd; font-size:12px;"></i>
                                            <div style="color:#2E7D32; font-size:24px; margin-bottom:12px;"><i
                                                    class="far fa-heart"></i></div>
                                            <p style="margin:0 0 8px 0; font-size:14px; color:#757575;">Sản phẩm yêu
                                                thích</p>
                                            <h3 style="margin:0 0 16px 0; font-size:24px;">
                                                <%= typeof wishlists !=='undefined' ? wishlists.length : 0 %> Cây
                                            </h3>
                                            <button class="btn-outline" style="width:100%; font-size:12px;"
                                                onclick="document.querySelector('.sidebar-menu a[data-target=\'wishlist\']').click()">Xem
                                                danh sách</button>
                                        </div>
                                        <div class="dash-card"
                                            style="flex:1; text-align:center; position:relative; padding:24px 16px;">
                                            <i class="fas fa-times"
                                                style="position:absolute; top:12px; right:12px; color:#bdbdbd; font-size:12px;"></i>
                                            <div style="color:#2E7D32; font-size:24px; margin-bottom:12px;"><i
                                                    class="far fa-file-alt"></i></div>
                                            <p style="margin:0 0 8px 0; font-size:14px; color:#757575;">Đơn hàng tích
                                                lũy</p>
                                            <h3 style="margin:0 0 16px 0; font-size:24px;">
                                                <%= typeof orders !=='undefined' ? orders.length : 0 %>
                                            </h3>
                                            <a href="/orders/my-orders"
                                                class="btn btn-primary-solid d-block text-decoration-none"
                                                style="width:100%; font-size:12px; text-align:center;">Chi tiết</a>
                                        </div>
                                        <div class="dash-card"
                                            style="flex:1; text-align:center; position:relative; padding:24px 16px;">
                                            <i class="fas fa-times"
                                                style="position:absolute; top:12px; right:12px; color:#bdbdbd; font-size:12px;"></i>
                                            <div style="color:#2E7D32; font-size:24px; margin-bottom:12px;"><i
                                                    class="fas fa-leaf"></i></div>
                                            <p style="margin:0 0 8px 0; font-size:14px; color:#757575;">Điểm thành viên
                                            </p>
                                            <h3 style="margin:0 0 16px 0; font-size:24px;">1,150</h3>
                                            <button class="btn-outline"
                                                style="width:100%; font-size:12px; border-color:transparent; color:#9e9e9e;"
                                                onclick="alert('Kho quà tặng đang được cập nhật! Tính năng đổi quà sẽ sớm ra mắt.')">Đổi
                                                quà ngay</button>
                                        </div>
                                    </div>
                                </section>

                                <!-- Payment History -->
                                <section class="history-section">
                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <h3>Giao dịch gần đây</h3>
                                    </div>

                                    <div class="history-tabs">
                                        <span class="active" data-filter="all">Tất cả</span>
                                        <span data-filter="pending">Chờ duyệt</span>
                                        <span data-filter="delivered">Hoàn thành</span>
                                        <span data-filter="cancelled">Đã hủy</span>
                                    </div>

                                    <div class="dash-card" style="padding: 0 24px;">
                                        <table class="history-table" id="historyTable">
                                            <thead>
                                                <tr>
                                                    <th>Sản phẩm</th>
                                                    <th>Giá tiền</th>
                                                    <th>Ngày đặt</th>
                                                    <th>Trạng thái</th>
                                                    <th>Phí vận chuyển</th>
                                                    <th>Mã đơn</th>
                                                    <th>Hành động</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (typeof orders !=='undefined' && orders && orders.length> 0) { %>
                                                    <% orders.forEach(order=> { %>
                                                        <% let firstItem=order.items[0]; let statusBadge="badge-pending"
                                                            ; let statusText="Chờ duyệt" ; if(order.status==='delivered'
                                                            ) { statusBadge="badge-success" ; statusText="Hoàn thành" ;
                                                            } else if(order.status==='cancelled' ) {
                                                            statusBadge="badge-danger" ; statusText="Đã hủy" ; } else
                                                            if(order.status==='shipping' ) { statusBadge="badge-info" ;
                                                            statusText="Đang giao" ; } // String cho live search let
                                                            searchString=`${firstItem?.name || 'Cây cảnh' }
                                                            ${order._id.toString().slice(-6).toUpperCase()}`.toLowerCase();
                                                            %>
                                                            <tr data-search="<%= searchString %>" data-status="<%= order.status %>">
                                                                <td>
                                                                    <div class="product-cell">
                                                                        <img src="<%= firstItem?.product_id?.image ? '/images/products/' + firstItem.product_id.image : '/images/default.jpg' %>"
                                                                            alt="Product">
                                                                        <div>
                                                                            <p class="product-name">
                                                                                <%= firstItem?.name || 'Cây cảnh' %>
                                                                            </p>
                                                                            <p class="product-desc">Đơn: #<%=
                                                                                    order._id.toString().slice(-6).toUpperCase()
                                                                                    %>
                                                                            </p>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <%= parseInt(order.total_price).toLocaleString('vi-VN')
                                                                        %>đ
                                                                </td>
                                                                <td style="color:#757575;">
                                                                    <%= new
                                                                        Date(order.createdAt).toLocaleDateString('vi-VN')
                                                                        %>
                                                                </td>
                                                                <td>
                                                                    <span class="badge-status <%= statusBadge %>">
                                                                        <%= statusText %>
                                                                    </span>
                                                                </td>
                                                                <td style="color:#757575;">Miễn phí</td>
                                                                <td style="color:#757575;">
                                                                    <%= order._id.toString().slice(-4).toUpperCase() %>
                                                                </td>
                                                                <td>
                                                                    <a href="/orders/my-orders?id=<%= order._id %>"
                                                                        class="btn btn-primary-solid text-decoration-none"
                                                                        style="background:#E8F5E9; color:#2E7D32; border:none; padding: 4px 12px;">Chi
                                                                        tiết</a>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <tr>
                                                                        <td colspan="7"
                                                                            style="text-align:center; padding: 32px 0; color:#9e9e9e;">
                                                                            Chưa có lịch sử giao dịch</td>
                                                                    </tr>
                                                                    <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            </div>

                            <!-- TAB: PROFILE -->
                            <div id="profile" class="tab-pane" style="display: none;">
                                <div class="row">
                                    <!-- AVATAR UPLOAD SECTION -->
                                    <div class="col-12 mb-4">
                                        <div class="dash-card">
                                            <h4 style="margin-bottom: 24px; color: #2E7D32;"><i class="fas fa-camera me-2"></i>Ảnh đại diện</h4>
                                            <form action="/user/profile/avatar" method="POST" enctype="multipart/form-data" class="d-flex align-items-center gap-4 flex-wrap">
                                                <div class="position-relative">
                                                    <% if (userInfo.avatar) { %>
                                                        <img id="avatarPreview" src="<%= userInfo.avatar %>" alt="Avatar" class="rounded-circle border border-2 border-success" width="100" height="100" style="object-fit:cover;">
                                                    <% } else { %>
                                                        <img id="avatarPreview" src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(userInfo.name) %>&background=e2e8e4&color=2d5f3f" alt="Avatar" class="rounded-circle border border-2 border-success" width="100" height="100" style="object-fit:cover;">
                                                    <% } %>
                                                </div>
                                                <div class="flex-grow-1" style="max-width: 400px;">
                                                    <input type="file" name="avatar" id="avatarInput" class="form-control mb-2" accept="image/*" required onchange="document.getElementById('avatarPreview').src = window.URL.createObjectURL(this.files[0])">
                                                    <small class="text-muted d-block mb-2">Định dạng JPG, PNG, WEBP.</small>
                                                    <button type="submit" class="btn btn-outline-success btn-sm px-4"><i class="fas fa-upload me-1"></i>Lưu ảnh đại diện</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-4">
                                        <div class="dash-card h-100">
                                            <h4 style="margin-bottom: 24px; color: #2E7D32;"><i
                                                    class="fas fa-user-edit me-2"></i>Thông tin cá nhân</h4>
                                            <form action="/user/profile/update" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label">Họ tên <span
                                                            class="text-danger">*</span></label>
                                                    <input type="text" name="name" class="form-control"
                                                        value="<%= userInfo.name %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Email <span
                                                            class="text-danger">*</span></label>
                                                    <input type="email" name="email" class="form-control"
                                                        value="<%= userInfo.email %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Vai trò</label>
                                                    <input type="text" class="form-control"
                                                        value="<%= userInfo.role === 'admin' ? 'Quản trị viên' : userInfo.role === 'staff' ? 'Nhân viên' : 'Khách hàng' %>"
                                                        disabled>
                                                </div>
                                                <button type="submit" class="btn-primary-solid w-100 mt-3 py-2"><i
                                                        class="fas fa-save me-2"></i>Lưu thông tin</button>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-4">
                                        <div class="dash-card h-100">
                                            <h4 style="margin-bottom: 24px; color: #2E7D32;"><i
                                                    class="fas fa-shield-alt me-2"></i>Đổi mật khẩu</h4>
                                            <form action="/user/profile/change-password" method="POST">
                                                <div class="mb-3 position-relative">
                                                    <label class="form-label">Mật khẩu hiện tại <span
                                                            class="text-danger">*</span></label>
                                                    <input type="password" name="currentPassword" id="currentPassword"
                                                        class="form-control" required>
                                                    <button type="button" class="btn-eye"
                                                        onclick="togglePwd('currentPassword', this)"><i
                                                            class="fas fa-eye"></i></button>
                                                </div>
                                                <div class="mb-3 position-relative">
                                                    <label class="form-label">Mật khẩu mới <span
                                                            class="text-danger">*</span></label>
                                                    <input type="password" name="newPassword" id="newPassword"
                                                        class="form-control" placeholder="Tối thiểu 6 ký tự" required>
                                                    <button type="button" class="btn-eye"
                                                        onclick="togglePwd('newPassword', this)"><i
                                                            class="fas fa-eye"></i></button>
                                                </div>
                                                <div class="mb-3 position-relative">
                                                    <label class="form-label">Xác nhận mật khẩu mới <span
                                                            class="text-danger">*</span></label>
                                                    <input type="password" name="confirmPassword" id="confirmPassword"
                                                        class="form-control" required>
                                                    <button type="button" class="btn-eye"
                                                        onclick="togglePwd('confirmPassword', this)"><i
                                                            class="fas fa-eye"></i></button>
                                                </div>
                                                <button type="submit" class="btn-primary-solid w-100 mt-3 py-2"><i
                                                        class="fas fa-key me-2"></i>Cập nhật mật khẩu</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- TAB: ADDRESS -->
                            <div id="address" class="tab-pane" style="display: none;">
                                <div class="dash-card">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h4 style="margin: 0; color: #2E7D32;"><i
                                                class="fas fa-map-marked-alt me-2"></i>Sổ địa chỉ</h4>
                                        <button class="btn-primary-solid" data-bs-toggle="modal"
                                            data-bs-target="#addAddressModal">
                                            <i class="fas fa-plus me-1"></i>Thêm địa chỉ mới
                                        </button>
                                    </div>
                                    <div id="addressList">
                                        <div class="text-center py-5 text-muted">
                                            <i class="fas fa-spinner fa-spin fs-4 mb-2"></i><br>
                                            Đang tải dữ liệu...
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- TAB: WISHLIST -->
                            <div id="wishlist" class="tab-pane" style="display: none;">
                                <div class="dash-card">
                                    <h4 style="margin: 0 0 24px 0; color: #2E7D32;"><i class="fas fa-heart me-2"></i>Sản
                                        phẩm yêu thích</h4>

                                    <% if (typeof wishlists !=='undefined' && wishlists && wishlists.length> 0) { %>
                                        <div class="row row-cols-1 row-cols-md-3 g-4">
                                            <% wishlists.forEach(item=> { %>
                                                <% const p=item.product_id; %>
                                                    <div class="col">
                                                        <div class="card h-100 shadow-sm border-0"
                                                            style="border-radius:12px; overflow:hidden;">
                                                            <div
                                                                style="height: 200px; overflow: hidden; position: relative;">
                                                                <img src="<%= p?.image ? '/images/products/' + p.image : '/images/default.jpg' %>"
                                                                    class="w-100 h-100" style="object-fit:cover;"
                                                                    alt="<%= p?.name %>">
                                                                <button
                                                                    class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle text-danger"
                                                                    style="width:36px; height:36px; padding:0;"
                                                                    onclick="removeFromWishlist('<%= p?._id %>')">
                                                                    <i class="fas fa-heart"></i>
                                                                </button>
                                                            </div>
                                                            <div class="card-body">
                                                                <h6 class="card-title text-truncate fw-bold mb-1">
                                                                    <%= p?.name %>
                                                                </h6>
                                                                <p class="text-success fw-bold mb-2">
                                                                    <%= parseInt(p?.price || 0).toLocaleString('vi-VN')
                                                                        %>đ
                                                                </p>
                                                                <a href="/product/<%= p?.slug || p?._id %>"
                                                                    class="btn btn-outline-success btn-sm w-100"
                                                                    style="border-radius:8px;">Mua ngay</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                        </div>
                                        <% } else { %>
                                            <div class="text-center py-5 text-muted">
                                                <i class="far fa-heart fs-1 mb-3 text-success opacity-50"></i>
                                                <p class="mb-0">Bạn chưa có sản phẩm yêu thích nào.</p>
                                                <a href="/shop" class="btn btn-primary-solid mt-3">Tiếp tục mua sắm</a>
                                            </div>
                                            <% } %>
                                </div>
                            </div>

                            <!-- TAB: PAYMENT -->
                            <div id="payment" class="tab-pane" style="display: none;">
                                <div class="dash-card">
                                    <h4 style="margin: 0 0 24px 0; color: #2E7D32;"><i
                                            class="fas fa-wallet me-2"></i>Cài đặt thanh toán</h4>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="p-4 border rounded"
                                                style="background: #fafafa; border-radius: 12px !important;">
                                                <h6 class="fw-bold mb-3">Phương thức thanh toán mặc định</h6>
                                                <div class="form-check mb-3 p-3 bg-white border rounded"
                                                    style="border-color:#2E7D32 !important; box-shadow: 0 0 0 2px rgba(46,125,50,0.2);">
                                                    <input class="form-check-input ms-1" type="radio"
                                                        name="paymentMethod" id="payCOD" checked>
                                                    <label class="form-check-label ms-2 fw-500" for="payCOD">
                                                        <i class="fas fa-truck text-success me-2"></i> Thanh toán khi
                                                        nhận hàng (COD)
                                                    </label>
                                                </div>
                                                <div class="form-check mb-3 p-3 bg-white border rounded">
                                                    <input class="form-check-input ms-1" type="radio"
                                                        name="paymentMethod" id="payBank">
                                                    <label class="form-check-label ms-2 fw-500" for="payBank">
                                                        <i class="fas fa-university text-primary me-2"></i> Chuyển khoản
                                                        ngân hàng
                                                    </label>
                                                </div>
                                                <div class="form-check mb-3 p-3 bg-white border rounded">
                                                    <input class="form-check-input ms-1" type="radio"
                                                        name="paymentMethod" id="payZalo">
                                                    <label class="form-check-label ms-2 fw-500" for="payZalo">
                                                        <i class="fas fa-qrcode text-info me-2"></i> Ví ZaloPay / MoMo
                                                    </label>
                                                </div>
                                                <button class="btn-primary-solid w-100"
                                                    onclick="alert('Đã cập nhật phương thức thanh toán mặc định!')">Cập
                                                    nhật phương thức</button>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-4 border rounded h-100"
                                                style="background: #E8F5E9; border-radius: 12px !important;">
                                                <h6 class="fw-bold text-success mb-3">Ví điểm thành viên</h6>
                                                <div class="text-center my-4">
                                                    <h1 class="display-4 fw-bold text-success mb-0">1,150</h1>
                                                    <p class="text-muted">Điểm hiện có</p>
                                                </div>
                                                <p class="small text-muted mb-4 text-center">Bạn có thể sử dụng điểm này
                                                    để quy đổi thành mã giảm giá ở bước thanh toán đơn hàng.</p>
                                                <button class="btn btn-outline-success w-100 fw-bold"
                                                    style="border-radius:8px; background: white;"
                                                    onclick="alert('Tính năng đổi mã giảm giá đang phát triển!')">Đổi
                                                    Voucher ngay</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

        </main>

        <!-- ==================== RIGHT PANEL ==================== -->
        <aside class="dash-panel-right">

            <!-- Prepay Card -->
            <div class="dash-card prepay-card">
                <h4>Thẻ Thành Viên</h4>
                <p>Quản lý hạng thẻ, tích điểm và ưu đãi cá nhân</p>

                <div style="text-align:left; margin-bottom:16px;">
                    <label style="font-size:12px; color:#757575; display:block; margin-bottom:4px;">Phương thức mặc
                        định</label>
                    <div style="border-bottom:1px solid #e0e0e0; padding-bottom:8px; font-size:14px; cursor:pointer;"
                        onclick="document.querySelector('.sidebar-menu a[data-target=\'payment\']').click()">Thanh toán
                        khi nhận hàng ></div>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <span style="font-size:14px;">Nhận thông báo qua SMS</span>
                    <button class="btn-primary-solid" style="padding: 4px 12px; font-size:12px;">Đã Bật</button>
                </div>

                <button class="btn-primary-solid" style="width:100%;"
                    onclick="document.querySelector('.sidebar-menu a[data-target=\'payment\']').click()">Quản lý
                    ví</button>
            </div>

            <!-- System Notifications -->
            <div class="tamil-notations">
                <h4>Bảng tin hệ thống</h4>
                <div class="dash-card" style="padding: 16px;">
                    <a href="/plant-care" class="notation-item" style="display:flex; justify-content:space-between; align-items:center; text-decoration:none; color:inherit; padding-bottom:12px; border-bottom:1px solid #eee; margin-bottom:12px; cursor:pointer;">
                        <span><i class="fas fa-leaf text-success me-2"></i> Bí kíp chăm sóc cây</span>
                        <i class="fas fa-chevron-right" style="color:#bdbdbd; font-size:12px;"></i>
                    </a>
                    <a href="/shop" class="notation-item" style="display:flex; justify-content:space-between; align-items:center; text-decoration:none; color:inherit; padding-bottom:12px; border-bottom:1px solid #eee; margin-bottom:12px; cursor:pointer;">
                        <span><i class="fas fa-gift text-danger me-2"></i> Khuyến mãi cuối năm</span>
                        <i class="fas fa-chevron-right" style="color:#bdbdbd; font-size:12px;"></i>
                    </a>
                    <a href="/orders/my-orders?tab=delivered" class="notation-item" style="display:flex; justify-content:space-between; align-items:center; text-decoration:none; color:inherit; cursor:pointer; padding-bottom:0; border:none;">
                        <span><i class="fas fa-star text-warning me-2"></i> Đánh giá sản phẩm</span>
                        <i class="fas fa-chevron-right" style="color:#bdbdbd; font-size:12px;"></i>
                    </a>
                </div>
            </div>

        </aside>

    </div>

    <!-- Modals for Address Book ... -->
    <div class="modal fade" id="addAddressModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Thêm địa chỉ mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form onsubmit="submitAddAddress(event)">
                    <div class="modal-body p-4 dash-card shadow-none">
                        <div id="addAddrError" class="text-danger small mb-3"></div>
                        <div class="mb-3">
                            <label class="form-label">Tên người nhận <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="phone" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                            <textarea name="address" class="form-control" rows="3"
                                placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành" required></textarea>
                        </div>
                        <div class="form-check mt-3">
                            <input type="checkbox" name="isDefault" value="true" class="form-check-input"
                                id="addDefault">
                            <label class="form-check-label text-muted" for="addDefault">Đặt làm địa chỉ mặc định</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-4 px-4 bg-white rounded-bottom">
                        <button type="button" class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn-primary-solid rounded-pill px-4">Lưu địa chỉ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editAddressModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Cập nhật địa chỉ</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form onsubmit="submitEditAddress(event)">
                    <div class="modal-body p-4 dash-card shadow-none">
                        <input type="hidden" id="editAddrId">
                        <div id="editAddrError" class="text-danger small mb-3"></div>
                        <div class="mb-3">
                            <label class="form-label">Tên người nhận <span class="text-danger">*</span></label>
                            <input type="text" name="name" id="editAddrName" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="phone" id="editAddrPhone" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                            <textarea name="address" id="editAddrAddress" class="form-control" rows="3"
                                required></textarea>
                        </div>
                        <div class="form-check mt-3">
                            <input type="checkbox" name="isDefault" value="true" class="form-check-input"
                                id="editAddrDefault">
                            <label class="form-check-label text-muted" for="editAddrDefault">Đặt làm địa chỉ mặc
                                định</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-4 px-4 bg-white rounded-bottom">
                        <button type="button" class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn-primary-solid rounded-pill px-4">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="/js/address.js"></script>
    <script src="/js/profile.js"></script>

    <% if(locals.tab) { %>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const tabLink = document.querySelector('.sidebar-menu a[data-target="<%= tab %>"]');
                if (tabLink) {
                    tabLink.click();
                }
            });
        </script>
        <% } %>

</body>

</html>