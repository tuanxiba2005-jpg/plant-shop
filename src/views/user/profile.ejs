<% extraJS=['/js/address.js'] %>
    <%- include('../layouts/header') %>

        <div class="row">

            <!-- Sidebar -->
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-4">
                        <div
                            style="width:72px; height:72px; border-radius:50%; background:var(--primary-bg); display:flex; align-items:center; justify-content:center; font-size:28px; font-weight:700; color:var(--primary); margin:0 auto 12px;">
                            <%= userInfo.name.charAt(0).toUpperCase() %>
                        </div>
                        <h6 class="fw-bold mb-1">
                            <%= userInfo.name %>
                        </h6>
                        <small class="text-muted">
                            <%= userInfo.email %>
                        </small>
                        <div class="mt-2">
                            <% if (userInfo.role==='admin' ) { %>
                                <span class="badge bg-danger">Quản trị viên</span>
                                <% } else if (userInfo.role==='staff' ) { %>
                                    <span class="badge bg-warning">Nhân viên</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Khách hàng</span>
                                        <% } %>
                        </div>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="/user/profile" class="list-group-item list-group-item-action active">
                            👤 Thông tin tài khoản
                        </a>
                        <a href="/orders/my-orders" class="list-group-item list-group-item-action">
                            📦 Đơn hàng của tôi
                        </a>
                        <% if (userInfo.role==='admin' ) { %>
                            <a href="/admin/dashboard" class="list-group-item list-group-item-action">
                                ⚙️ Trang Admin
                            </a>
                            <% } else if (userInfo.role==='staff' ) { %>
                                <a href="/staff/dashboard" class="list-group-item list-group-item-action">
                                    📋 Trang Nhân viên
                                </a>
                                <% } %>
                                    <a href="/user/logout" class="list-group-item list-group-item-action text-danger">
                                        🚪 Đăng xuất
                                    </a>
                    </div>
                </div>
            </div>

            <!-- Nội dung -->
            <div class="col-md-9">

                <!-- Thông báo -->
                <% if (locals.success) { %>
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
                        <i class="fas fa-check-circle"></i>
                        <%= success %>
                    </div>
                    <% } %>
                        <% if (locals.error) { %>
                            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                                <i class="fas fa-exclamation-circle"></i>
                                <%= error %>
                            </div>
                            <% } %>
                                <!-- Thống kê Đơn mua (Shopee Style) -->
                                <div class="card shadow-sm mb-4" style="border-radius: 12px; border: none;">
                                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3"
                                        style="border-bottom: 1px solid #f0f0f0;">
                                        <h6 class="mb-0 fw-bold"><i
                                                class="fas fa-clipboard-list text-success me-2"></i>Đơn mua</h6>
                                        <a href="/orders/my-orders" class="text-decoration-none text-muted small">Xem
                                            lịch sử mua hàng <i class="fas fa-chevron-right ms-1"
                                                style="font-size: 10px;"></i></a>
                                    </div>
                                    <div class="card-body py-4">
                                        <div class="row text-center">
                                            <div class="col-3">
                                                <a href="/orders/my-orders?tab=pending"
                                                    class="text-decoration-none text-dark d-block">
                                                    <div class="position-relative d-inline-block mb-2"
                                                        style="font-size: 26px; color: #555;">
                                                        <i class="fas fa-wallet"></i>
                                                    </div>
                                                    <div class="small">Chờ xác nhận</div>
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <a href="/orders/my-orders?tab=confirmed"
                                                    class="text-decoration-none text-dark d-block">
                                                    <div class="position-relative d-inline-block mb-2"
                                                        style="font-size: 26px; color: #555;">
                                                        <i class="fas fa-box"></i>
                                                    </div>
                                                    <div class="small">Chờ lấy hàng</div>
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <a href="/orders/my-orders?tab=shipping"
                                                    class="text-decoration-none text-dark d-block">
                                                    <div class="position-relative d-inline-block mb-2"
                                                        style="font-size: 26px; color: #555;">
                                                        <i class="fas fa-truck"></i>
                                                    </div>
                                                    <div class="small">Chờ giao hàng</div>
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <a href="/orders/my-orders?tab=delivered"
                                                    class="text-decoration-none text-dark d-block">
                                                    <div class="position-relative d-inline-block mb-2"
                                                        style="font-size: 26px; color: #555;">
                                                        <i class="far fa-star"></i>
                                                    </div>
                                                    <div class="small">Đánh giá</div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tab -->
                                <ul class="nav nav-pills mb-4" id="profileTab">
                                    <li class="nav-item">
                                        <button class="nav-link" id="tab-info" onclick="switchProfileTab('info')">
                                            <i class="fas fa-user me-1"></i> Thông tin
                                        </button>
                                    </li>
                                    <li class="nav-item ms-2">
                                        <button class="nav-link" id="tab-password"
                                            onclick="switchProfileTab('password')">
                                            <i class="fas fa-lock me-1"></i> Đổi mật khẩu
                                        </button>
                                    </li>
                                    <li class="nav-item ms-2">
                                        <button class="nav-link" id="tab-address" onclick="switchProfileTab('address')">
                                            <i class="fas fa-map-marker-alt me-1"></i> Địa chỉ giao hàng
                                        </button>
                                    </li>
                                </ul>

                                <!-- Panel: Thông tin cá nhân -->
                                <div id="panel-info" class="profile-panel" style="display:none;">
                                    <div class="card shadow-sm">
                                        <div class="card-header bg-success text-white fw-bold">
                                            <i class="fas fa-user me-2"></i>Thông tin cá nhân
                                        </div>
                                        <div class="card-body p-4">
                                            <form action="/user/profile/update" method="POST">
                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Họ tên <span
                                                                class="text-danger">*</span></label>
                                                        <input type="text" name="name" class="form-control"
                                                            value="<%= userInfo.name %>" required>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Email <span
                                                                class="text-danger">*</span></label>
                                                        <input type="email" name="email" class="form-control"
                                                            value="<%= userInfo.email %>" required>
                                                    </div>
                                                </div>
                                                <div class="row mb-4">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Vai trò</label>
                                                        <input type="text" class="form-control"
                                                            value="<%= userInfo.role === 'admin' ? 'Quản trị viên' : userInfo.role === 'staff' ? 'Nhân viên' : 'Khách hàng' %>"
                                                            disabled>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Ngày tham gia</label>
                                                        <input type="text" class="form-control"
                                                            value="<%= new Date(userInfo.createdAt).toLocaleDateString('vi-VN') %>"
                                                            disabled>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end">
                                                    <button type="submit" class="btn btn-success px-4">
                                                        <i class="fas fa-save me-2"></i>Lưu thay đổi
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Panel: Đổi mật khẩu -->
                                <div id="panel-password" class="profile-panel" style="display:none;">
                                    <div class="card shadow-sm">
                                        <div class="card-header bg-success text-white fw-bold">
                                            <i class="fas fa-lock me-2"></i>Đổi mật khẩu
                                        </div>
                                        <div class="card-body p-4">
                                            <form action="/user/profile/change-password" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label">Mật khẩu hiện tại <span
                                                            class="text-danger">*</span></label>
                                                    <div class="position-relative">
                                                        <input type="password" name="currentPassword"
                                                            id="currentPassword" class="form-control"
                                                            placeholder="Nhập mật khẩu hiện tại">
                                                        <button type="button" class="btn-eye"
                                                            onclick="togglePwd('currentPassword', this)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Mật khẩu mới <span
                                                            class="text-danger">*</span></label>
                                                    <div class="position-relative">
                                                        <input type="password" name="newPassword" id="newPassword"
                                                            class="form-control" placeholder="Tối thiểu 6 ký tự">
                                                        <button type="button" class="btn-eye"
                                                            onclick="togglePwd('newPassword', this)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="mb-4">
                                                    <label class="form-label">Xác nhận mật khẩu mới <span
                                                            class="text-danger">*</span></label>
                                                    <div class="position-relative">
                                                        <input type="password" name="confirmPassword"
                                                            id="confirmPassword" class="form-control"
                                                            placeholder="Nhập lại mật khẩu mới">
                                                        <button type="button" class="btn-eye"
                                                            onclick="togglePwd('confirmPassword', this)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </div>
                                                    <div id="pwdMatchMsg" class="small mt-1"></div>
                                                </div>
                                                <div class="d-flex justify-content-end">
                                                    <button type="submit" class="btn btn-success px-4">
                                                        <i class="fas fa-key me-2"></i>Đổi mật khẩu
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Panel: Địa chỉ giao hàng -->
                                <div id="panel-address" class="profile-panel" style="display:none;">
                                    <div class="card shadow-sm">
                                        <div
                                            class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                                            <span><i class="fas fa-map-marker-alt me-2"></i>Địa chỉ giao hàng</span>
                                            <button class="btn btn-light btn-sm" data-bs-toggle="modal"
                                                data-bs-target="#addAddressModal">
                                                <i class="fas fa-plus me-1"></i>Thêm địa chỉ
                                            </button>
                                        </div>
                                        <div class="card-body p-3">
                                            <div id="addressList">
                                                <div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i>
                                                    Đang tải...</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

            </div>
        </div>

        <!-- Modal: Thêm địa chỉ -->
        <div class="modal fade" id="addAddressModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">Thêm địa chỉ mới</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form onsubmit="submitAddAddress(event)">
                        <div class="modal-body">
                            <div id="addAddrError" class="text-danger small mb-2"></div>
                            <div class="mb-3">
                                <label class="form-label">Tên người nhận <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                                <textarea name="address" class="form-control" rows="3"
                                    placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành"
                                    required></textarea>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="isDefault" value="true" class="form-check-input"
                                    id="addDefault">
                                <label class="form-check-label" for="addDefault">Đặt làm địa chỉ mặc định</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-success">Lưu địa chỉ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal: Sửa địa chỉ -->
        <div class="modal fade" id="editAddressModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">Cập nhật địa chỉ</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form onsubmit="submitEditAddress(event)">
                        <div class="modal-body">
                            <input type="hidden" id="editAddrId">
                            <div id="editAddrError" class="text-danger small mb-2"></div>
                            <div class="mb-3">
                                <label class="form-label">Tên người nhận <span class="text-danger">*</span></label>
                                <input type="text" name="name" id="editAddrName" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" id="editAddrPhone" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                                <textarea name="address" id="editAddrAddress" class="form-control" rows="3"
                                    required></textarea>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="isDefault" value="true" class="form-check-input"
                                    id="editAddrDefault">
                                <label class="form-check-label" for="editAddrDefault">Đặt làm địa chỉ mặc định</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../layouts/footer') %>