<%- include('../layouts/header') %>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-success text-center">
                <h4 class="mb-0 text-white">Quên mật khẩu</h4>
            </div>
            <div class="card-body">
                <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
                <p class="text-center mt-3 mb-0">
                    <a href="/user/login" class="text-success fw-bold">Quay lại đăng nhập</a>
                </p>
                <% } else { %>
                <p class="text-muted mb-4">Nhập email của bạn, chúng tôi sẽ gửi link đặt lại mật khẩu.</p>
                <form action="/user/forgot-password" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control"
                               placeholder="example@email.com" required>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Gửi link đặt lại</button>
                </form>
                <hr>
                <p class="text-center mb-0">
                    <a href="/user/login" class="text-success">Quay lại đăng nhập</a>
                </p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
